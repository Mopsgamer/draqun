<div class="p-page max-w-md mx-auto">
    <h1 class="text-2xl font-bold mb-4 flex items-center gap-2">
        <span class="icon icon-[lucide--log-in]" aria-hidden="true"></span>
        Log In
    </h1>
    <form
        class="flex flex-col gap-4 bg-surface-card p-6 rounded-box border border-base-content/10 shadow-sm"
        id="login-form"
        name="login-form"
        hx-post="/account/login"
        hx-swap="innerHTML"
        hx-target="#login-error"
    >
        <div class="flex flex-col gap-1 w-full">
            <label class="text-sm font-semibold" for="login-email">Email</label>
            <input
                class="input input-bordered w-full"
                autofocus
                type="email"
                autocomplete="email"
                id="login-email"
                name="email"
                inputmode="email"
                required
            >
        </div>
        <div class="flex flex-col gap-1 w-full">
            <label class="text-sm font-semibold" for="login-password">Password</label>
            <div class="relative w-full">
                <input
                    class="input input-bordered w-full pr-12"
                    type="password"
                    autocomplete="current-password"
                    name="password"
                    id="login-password"
                    required
                >
                <button type="button" class="absolute inset-y-0 right-2 inline-flex items-center justify-center p-1 text-base-content/70 hover:text-base-content cursor-pointer" aria-label="Show password" aria-pressed="false" data-toggle-password>
                    <span class="icon icon-[lucide--eye] size-5" aria-hidden="true" data-password-visible></span>
                    <span class="icon icon-[lucide--eye-off] size-5" aria-hidden="true" data-password-hidden hidden></span>
                </button>
            </div>
        </div>
        <div id="login-error"></div>
        <div class="flex items-center justify-between pt-2">
            <div class="text-sm">
                Not a member?
                <a class="btn btn-ghost btn-sm" href="/signup">Sign Up</a>
            </div>
            <div>
                <button class="btn btn-primary" form="login-form" type="submit">Log In</button>
            </div>
        </div>
    </form>
</div>
