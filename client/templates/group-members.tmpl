<div class="max-w-3xl mx-auto w-full px-4 py-8 flex flex-col gap-8">
    <div class="flex items-center justify-between pb-4 border-b border-base-content/10">
        <div class="flex items-center gap-3">
            <span class="icon icon-[lucide--settings-2] size-6 text-primary" aria-hidden="true"></span>
            <div>
                <h1 class="text-2xl font-bold tracking-tight">Group Settings</h1>
            </div>
        </div>
        <button class="btn btn-ghost btn-sm text-base-content/70 hover:text-base-content" type="button" onclick="history.back()">
            <span class="icon icon-[lucide--arrow-left] size-4" aria-hidden="true"></span>
            Back
        </button>
    </div>

    {{template "partials/group-settings-nav" .}}

    <div class="flex flex-col gap-6">
        <!-- Members Header -->
        <div class="flex items-center justify-between pb-2 border-b border-base-content/10">
            <h2 class="text-base font-bold flex items-center gap-2">
                <span class="icon icon-[lucide--user-check] size-4 text-primary" aria-hidden="true"></span>
                Active Members ({{len .MemberItems}})
            </h2>
        </div>

        <!-- Continuous Members List -->
        <div class="divide-y divide-base-content/10">
            {{range .MemberItems}}
            {{$targetUser := .User}}
            <div class="py-4 flex flex-col gap-3">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div class="flex items-center gap-3.5">
                        <div class="avatar {{if .IsOnline}}avatar-online{{else}}avatar-offline{{end}} shrink-0" title="{{if .IsOnline}}Online{{else}}Offline{{end}}">
                            <div class="w-10 rounded-full">
                                <img src="{{.User.AvatarUrl}}" alt="{{.User.Moniker}}" />
                            </div>
                        </div>
                        <div class="flex flex-col">
                            <div class="flex items-center gap-2">
                                <span class="font-bold text-sm">{{.User.Moniker}}</span>
                                <span class="text-xs text-base-content/50 font-mono">@{{.User.Name}}</span>
                                {{if eq .User.Id $.Group.OwnerId}}
                                <span class="badge badge-primary badge-xs text-[10px] font-medium">Owner</span>
                                {{end}}
                            </div>

                            <!-- Role Chips -->
                            <div class="flex flex-wrap items-center gap-1.5 mt-1">
                                {{range .Roles}}
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium border" style="border-color: {{.Color.Hex}}40; background-color: {{.Color.Hex}}10; color: {{.Color.Hex}}">
                                    <span class="size-1.5 rounded-full" style="background-color: {{.Color.Hex}}"></span>
                                    {{.Moniker}}
                                    {{if or $.Role.PermRoles.Has $.Role.PermAdmin.Has (eq $.Member.UserId $.Group.OwnerId)}}
                                    <button
                                        type="button"
                                        class="hover:opacity-100 opacity-60 ml-0.5 cursor-pointer"
                                        hx-delete="/groups/{{$.Group.Id}}/members/{{$targetUser.Id}}/roles/{{.Id}}"
                                        title="Remove role"
                                    ><span class="icon icon-[lucide--x] size-3"></span></button>
                                    {{end}}
                                </span>
                                {{end}}
                            </div>
                        </div>
                    </div>

                    <!-- Role Add & Actions -->
                    <div class="flex items-center gap-2 shrink-0 self-start sm:self-center">
                        {{if or $.Role.PermRoles.Has $.Role.PermAdmin.Has (eq $.Member.UserId $.Group.OwnerId)}}
                        <form class="flex items-center gap-1" hx-post="/groups/{{$.Group.Id}}/members/{{$targetUser.Id}}/roles">
                            <select name="role_id" class="select select-bordered select-xs" required>
                                <option value="" disabled selected>+ Role</option>
                                {{range $.Roles}}
                                {{if ne .Name "@everyone"}}
                                <option value="{{.Id}}">{{.Moniker}}</option>
                                {{end}}
                                {{end}}
                            </select>
                            <button class="btn btn-ghost btn-xs" type="submit">Add</button>
                        </form>
                        {{end}}

                        {{if and (or $.Role.PermMembers.CanKickBan $.Role.PermAdmin.Has (eq $.Member.UserId $.Group.OwnerId)) (ne .User.Id $.Group.OwnerId)}}
                        <details class="dropdown dropdown-end">
                            <summary class="btn btn-warning btn-xs gap-1">Kick</summary>
                            <div class="dropdown-content z-20 p-3 shadow-lg bg-surface-card rounded-xl border border-base-content/10 w-64 mt-1 flex flex-col gap-2">
                                <span class="font-semibold text-xs">Kick {{.User.Moniker}}</span>
                                <form hx-post="/groups/{{$.Group.Id}}/members/{{.User.Id}}/kick" class="flex flex-col gap-2">
                                    <input type="text" name="description" placeholder="Reason (optional)" class="input input-bordered input-xs w-full">
                                    <button type="submit" class="btn btn-warning btn-xs w-full">Confirm Kick</button>
                                </form>
                            </div>
                        </details>

                        <details class="dropdown dropdown-end">
                            <summary class="btn btn-error btn-xs gap-1">Ban</summary>
                            <div class="dropdown-content z-20 p-3 shadow-lg bg-surface-card rounded-xl border border-base-content/10 w-64 mt-1 flex flex-col gap-2">
                                <span class="font-semibold text-xs">Ban {{.User.Moniker}}</span>
                                <form hx-post="/groups/{{$.Group.Id}}/members/{{.User.Id}}/ban" class="flex flex-col gap-2">
                                    <input type="text" name="description" placeholder="Reason (optional)" class="input input-bordered input-xs w-full">
                                    <input type="number" name="duration_days" placeholder="Days (default 365)" class="input input-bordered input-xs w-full" min="1" max="3650">
                                    <button type="submit" class="btn btn-error btn-xs w-full">Confirm Ban</button>
                                </form>
                            </div>
                        </details>
                        {{end}}
                    </div>
                </div>

                <!-- Subtle stats row -->
                <div class="text-[11px] text-base-content/50 flex flex-wrap gap-4 font-mono">
                    <span>Joined: {{.FirstJoinedAtStr}} ({{.FirstTenureStr}} ago)</span>
                    <span>Messages: <strong class="text-base-content/80">{{.MessagesCount}}</strong></span>
                    <span>Created: {{.AccountCreated}}</span>
                </div>
            </div>
            {{end}}
        </div>

        <!-- Banned Section (if present) -->
        {{if .BanItems}}
        <div class="pt-6 flex flex-col gap-4">
            <div class="pb-2 border-b border-error/20 text-error flex items-center gap-2">
                <span class="icon icon-[lucide--user-x] size-4"></span>
                <h2 class="text-base font-bold">Banned Users ({{len .BanItems}})</h2>
            </div>
            <div class="divide-y divide-error/15">
                {{range .BanItems}}
                <div class="py-3 flex items-center justify-between gap-4">
                    <div class="flex flex-col">
                        <div class="font-semibold text-sm flex items-center gap-2">
                            {{.Target.Moniker}}
                            <span class="text-xs font-mono text-base-content/50">@{{.Target.Name}}</span>
                        </div>
                        <div class="text-xs text-base-content/70 mt-0.5">Reason: {{.Ban.Description}}</div>
                    </div>
                    {{if or $.Role.PermMembers.CanKickBan $.Role.PermAdmin.Has (eq $.Member.UserId $.Group.OwnerId)}}
                    <button
                        class="btn btn-ghost btn-xs text-success hover:bg-success/10 gap-1 shrink-0"
                        hx-post="/groups/{{$.Group.Id}}/members/{{.Target.Id}}/unban"
                    >
                        <span class="icon icon-[lucide--check-circle] size-3"></span> Unban
                    </button>
                    {{end}}
                </div>
                {{end}}
            </div>
        </div>
        {{end}}
    </div>
</div>
