<button
    class="btn btn-ghost btn-square group-channels-toggle"
    type="button"
    aria-label="Toggle channels view"
    title="Toggle channels"
    aria-controls="channels-view"
    aria-expanded="false"
>
    <span class="icon icon-[lucide--hash] size-5" aria-hidden="true"></span>
</button>
<a
    class="btn btn-ghost btn-square"
    href="/groups/{{.Id}}/settings"
    aria-label="Group settings"
    title="Group settings"
>
    <span class="icon icon-[lucide--settings] size-5" aria-hidden="true"></span>
</a>
