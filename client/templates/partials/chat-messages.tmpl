{{- $this := . -}}
{{- range $i, $message := $this.MessageList -}}
{{- if and (eq $i 0) (eq (len $this.MessageList) $this.MessagesPagination) -}}
<div
    class="load-scroll"
    hx-trigger="intersect once"
    hx-swap="outerHTML"
    hx-get="/groups/{{$this.Group.Id}}/messages/page/{{add 1 $this.MessagesPage}}"
>
</div>
{{- end -}}

<div
    id="message-{{$message.Id}}"
    class="message"
    data-message="{{$message.Id}}"
    data-is-self="{{eq $message.AuthorId $this.User.Id}}"
    data-author="{{$message.AuthorId}}"
    data-created-at="{{- jsonTime $message.CreatedAt.Value}}"
>
    <div class="header">
        <div
            class="prefix cursor-pointer hover:opacity-80 transition-opacity group/author"
            hx-get="/users/{{$message.AuthorId}}/profile{{if $this.Group}}?group_id={{$this.Group.Id}}{{end}}"
            hx-target="#user-profile-modal-content"
            hx-swap="innerHTML"
            onclick="document.getElementById('user-profile-modal').showModal()"
            title="View profile of {{$message.Author.Moniker}}"
        >
            <div class="avatar shrink-0" aria-hidden="true">
                <div class="w-7 rounded-full">
                    <img src="{{$message.Author.AvatarUrl}}" alt="Author avatar">
                </div>
            </div>
            <span class="font-bold text-sm truncate max-w-52 group-hover/author:underline">{{$message.Author.Moniker}}</span>
        </div>
        <div class="suffix">
            <time
                class="date"
                datetime="{{jsonTime $message.CreatedAt.Value}}"
                data-format-date
            >{{jsonTime $message.CreatedAt.Value}}</time>
        </div>
    </div>
    {{if ne $message.Content ""}}
    <div class="text">{{$message.Content}}</div>
    {{end}}
    {{if ne $message.AttachmentUrl ""}}
    <div class="attachment">
        {{if $message.IsImageAttachment}}
        <div class="relative group/img inline-block max-w-sm rounded-lg overflow-hidden border border-base-content/10">
            <a href="{{$message.AttachmentUrl}}" target="_blank" rel="noopener noreferrer" class="block hover:opacity-90 transition-opacity" title="View image">
                <img src="{{$message.AttachmentUrl}}" alt="{{$message.AttachmentName}}" class="max-h-64 object-cover rounded-lg" />
            </a>
            <a
                href="{{$message.AttachmentUrl}}"
                download="{{$message.AttachmentName}}"
                class="absolute top-2 right-2 btn btn-xs btn-circle btn-neutral opacity-0 group-hover/img:opacity-100 transition-opacity shadow-md"
                title="Download {{$message.AttachmentName}}"
                aria-label="Download {{$message.AttachmentName}}"
            >
                <span class="icon icon-[lucide--download] size-3.5" aria-hidden="true"></span>
            </a>
        </div>
        {{else}}
        <a href="{{$message.AttachmentUrl}}" download="{{$message.AttachmentName}}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2.5 p-2.5 rounded-lg border border-base-content/15 hover:bg-surface-card-hover transition-colors text-xs font-medium max-w-sm" title="Download {{$message.AttachmentName}}">
            <span class="icon icon-[lucide--file-text] size-6 text-primary shrink-0" aria-hidden="true"></span>
            <div class="flex flex-col min-w-0 flex-1">
                <span class="truncate font-semibold text-base-content">{{$message.AttachmentName}}</span>
                <span class="text-[11px] text-base-content/50 font-mono">{{$message.FormattedSize}}</span>
            </div>
            <span class="icon icon-[lucide--download] size-4 text-base-content/60 shrink-0 ml-1" aria-hidden="true"></span>
        </a>
        {{end}}
    </div>
    {{end}}
</div>
{{- end}}
