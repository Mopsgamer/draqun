{{- $this := . -}}
{{- range $i, $message := $this.MessageList -}}
{{- if and (eq $i 0) (eq (len $this.MessageList) $this.MessagesPagination) -}}
<div
    class="load-scroll"
    hx-trigger="intersect once"
    hx-swap="outerHTML"
    hx-get="/groups/{{$this.Group.Id}}/messages/page/{{add 1 $this.MessagesPage}}"
>
</div>
{{- end -}}

<div
    id="message-{{$message.Id}}"
    class="message"
    data-message="{{$message.Id}}"
    data-is-self="{{eq $message.AuthorId $this.User.Id}}"
    data-author="{{$message.AuthorId}}"
    data-created-at="{{- jsonTime $message.CreatedAt.Value}}"
>
    <div class="header">
        <div class="prefix">
            <span class="inline-flex size-7 items-center justify-center rounded-full border border-dashed border-primary text-primary bg-primary/10 shrink-0 overflow-hidden" aria-hidden="true">
                {{if ne $message.Author.Avatar ""}}
                    <img src="{{$message.Author.Avatar}}" class="size-full object-cover rounded-full" alt="Author avatar">
                {{else}}
                    <span class="icon icon-[lucide--plus] size-4"></span>
                {{end}}
            </span>
            <span class="font-bold text-sm truncate max-w-52">{{$message.Author.Moniker}}</span>
        </div>
        <div class="suffix">
            <time
                class="date"
                datetime="{{jsonTime $message.CreatedAt.Value}}"
                data-format-date
            >{{jsonTime $message.CreatedAt.Value}}</time>
        </div>
    </div>
    <div class="text text-sm">{{$message.Content}}</div>
</div>
{{- end}}
