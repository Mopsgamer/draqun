{{- $this := . -}}
{{- range $i, $message := $this.MessageList -}}
{{- if and (eq $i 0) (eq (len $this.MessageList) $this.MessagesPagination) -}}
<div
    class="load-scroll"
    hx-trigger="intersect once"
    hx-swap="outerHTML"
    hx-get="/groups/{{$this.Group.Id}}/messages/page/{{add 1 $this.MessagesPage}}"
>
</div>
{{- end -}}

<div
    id="message-{{$message.Id}}"
    class="message"
    data-message="{{$message.Id}}"
    data-is-self="{{eq $message.AuthorId $this.User.Id}}"
    data-author="{{$message.AuthorId}}"
    data-created-at="{{- jsonTime $message.CreatedAt.Value}}"
>
    <div class="header">
        <div class="prefix">
            <span class="inline-flex size-7 items-center justify-center rounded-full bg-primary/10 text-primary shrink-0" aria-hidden="true">
                <span class="icon icon-[lucide--user-round] size-4"></span>
            </span>
            <span class="font-bold text-sm truncate max-w-52">{{$message.Author.Moniker}}</span>
        </div>
        <div class="suffix">
            <time
                class="date"
                datetime="{{jsonTime $message.CreatedAt.Value}}"
                data-format-date
            >{{jsonTime $message.CreatedAt.Value}}</time>
        </div>
    </div>
    <div class="text text-sm">{{$message.Content}}</div>
</div>
{{- end}}
