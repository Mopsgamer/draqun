<!-- Video Dock UI with z-30 (below collab context menu and notifications popover z-50) -->
<div id="collab-video-dock" class="fixed bottom-6 right-6 z-30 flex flex-col items-end gap-2 pointer-events-none {{if not (and .CollabSession (gt (len .CollabSession.Channels) 0))}}hidden{{end}}">
    <!-- Remote audio element for WebRTC voice communication -->
    <audio id="collab-remote-audio" autoplay playsinline class="hidden"></audio>
    <!-- Dock UI Toggle Bar (Hide/Unhide Dock) -->
    <div class="pointer-events-auto flex items-center gap-1 bg-base-300/80 backdrop-blur-md px-2 py-1 rounded-full shadow border border-base-content/10">
        <button
            type="button"
            id="collab-dock-toggle-btn"
            class="btn btn-ghost btn-circle btn-xs text-base-content/70 hover:text-base-content"
            title="Toggle dock UI"
            aria-label="Toggle dock UI"
            onclick="window.collabClient?.toggleDockUI()"
        >
            <span class="icon icon-[lucide--eye-off] size-3.5" id="collab-dock-toggle-icon"></span>
        </button>
    </div>

    <div id="collab-dock-tiles-container" class="flex flex-wrap justify-end gap-3 pointer-events-none max-w-[90vw]">
        <!-- 1. Local Camera Video Tile -->
        {{if and .CollabSession .CollabSession.IsCameraEnabled}}
        <div id="video-tile-local" class="pointer-events-auto relative rounded-xl overflow-hidden bg-neutral shadow-2xl border border-base-content/15 aspect-video w-48 sm:w-60 transition-transform duration-200">
            <video id="collab-local-video" autoplay playsinline muted class="w-full h-full object-contain"></video>
            <span id="collab-local-badge" class="absolute bottom-1.5 left-1.5 badge badge-neutral badge-xs text-[10px] font-medium opacity-90 shadow">You</span>
            
            <!-- Action buttons: Fullscreen & Close -->
            <div class="absolute top-1.5 right-1.5 flex items-center gap-1 z-10">
                <button
                    type="button"
                    class="btn btn-ghost btn-circle btn-xs text-white/90 hover:text-white hover:bg-black/40"
                    id="collab-btn-fullscreen-local"
                    title="Toggle fullscreen"
                    aria-label="Toggle fullscreen"
                    onclick="window.collabClient?.toggleTileFullscreen('video-tile-local')"
                >
                    <span class="icon icon-[lucide--maximize-2] size-3.5"></span>
                </button>
                <button
                    type="button"
                    class="btn btn-ghost btn-circle btn-xs text-white/90 hover:text-white hover:bg-black/40"
                    id="collab-btn-close-local"
                    onclick="window.collabClient?.triggerCameraToggle()"
                    title="Disable camera"
                    aria-label="Disable camera"
                >
                    <span class="icon icon-[lucide--x] size-3.5"></span>
                </button>
            </div>
        </div>
        {{end}}

        <!-- 2. Local Screen Share Video Tile -->
        {{if and .CollabSession .CollabSession.IsScreenShared}}
        <div id="video-tile-screen" class="pointer-events-auto relative rounded-xl overflow-hidden bg-neutral shadow-2xl border border-base-content/15 aspect-video w-48 sm:w-60 transition-transform duration-200">
            <video id="collab-screen-video" autoplay playsinline muted class="w-full h-full object-contain"></video>
            <span id="collab-screen-badge" class="absolute bottom-1.5 left-1.5 badge badge-neutral badge-xs text-[10px] font-medium opacity-90 shadow">Your screen</span>
            
            <!-- Action buttons: Fullscreen & Close -->
            <div class="absolute top-1.5 right-1.5 flex items-center gap-1 z-10">
                <button
                    type="button"
                    class="btn btn-ghost btn-circle btn-xs text-white/90 hover:text-white hover:bg-black/40"
                    id="collab-btn-fullscreen-screen"
                    title="Toggle fullscreen"
                    aria-label="Toggle fullscreen"
                    onclick="window.collabClient?.toggleTileFullscreen('video-tile-screen')"
                >
                    <span class="icon icon-[lucide--maximize-2] size-3.5"></span>
                </button>
                <button
                    type="button"
                    class="btn btn-ghost btn-circle btn-xs text-white/90 hover:text-white hover:bg-black/40"
                    id="collab-btn-close-screen"
                    hx-post="/groups/{{.Group.Id}}/collab/toggle-screenshare"
                    hx-target="#collab-dropdown-menu-content"
                    hx-swap="outerHTML"
                    title="Stop sharing screen"
                    aria-label="Stop sharing screen"
                >
                    <span class="icon icon-[lucide--x] size-3.5"></span>
                </button>
            </div>
        </div>
        {{end}}

        <!-- 3. Local File/Presentation Video Tile -->
        {{if and .CollabSession .CollabSession.IsFileShared}}
        <div id="video-tile-file" class="pointer-events-auto relative rounded-xl overflow-hidden bg-neutral shadow-2xl border border-base-content/15 aspect-video w-48 sm:w-60 transition-transform duration-200">
            <video id="collab-file-video" autoplay playsinline muted class="w-full h-full object-contain"></video>
            <span id="collab-file-badge" class="absolute bottom-1.5 left-1.5 badge badge-neutral badge-xs text-[10px] font-medium opacity-90 shadow truncate max-w-[140px]">{{if .CollabSession.SharedFileName}}Your presentation ({{.CollabSession.SharedFileName}}){{else}}Your presentation{{end}}</span>
            
            <!-- Action buttons: Fullscreen & Close -->
            <div class="absolute top-1.5 right-1.5 flex items-center gap-1 z-10">
                <button
                    type="button"
                    class="btn btn-ghost btn-circle btn-xs text-white/90 hover:text-white hover:bg-black/40"
                    id="collab-btn-fullscreen-file"
                    title="Toggle fullscreen"
                    aria-label="Toggle fullscreen"
                    onclick="window.collabClient?.toggleTileFullscreen('video-tile-file')"
                >
                    <span class="icon icon-[lucide--maximize-2] size-3.5"></span>
                </button>
                <button
                    type="button"
                    class="btn btn-ghost btn-circle btn-xs text-white/90 hover:text-white hover:bg-black/40"
                    id="collab-btn-close-file"
                    hx-post="/groups/{{.Group.Id}}/collab/toggle-presentation"
                    hx-target="#collab-dropdown-menu-content"
                    hx-swap="outerHTML"
                    title="Stop sharing presentation"
                    aria-label="Stop sharing presentation"
                >
                    <span class="icon icon-[lucide--x] size-3.5"></span>
                </button>
            </div>
        </div>
        {{end}}

        <!-- 4. Remote Video Tiles (Rendered by server when remote streams are active) -->
        {{if .CollabSession}}
        {{range .CollabSession.RemoteStreams}}
        <div id="{{.TileId}}" class="pointer-events-auto relative rounded-xl overflow-hidden bg-neutral shadow-2xl border border-base-content/15 aspect-video w-48 sm:w-60 transition-transform duration-200" data-remote-user-id="{{.UserId}}">
            <video id="{{.VideoElementId}}" data-remote-user-id="{{.UserId}}" data-remote-stream-type="{{.Type}}" autoplay playsinline muted class="w-full h-full object-contain"></video>
            <span class="absolute bottom-1.5 left-1.5 badge badge-neutral badge-xs text-[10px] font-medium opacity-90 shadow truncate max-w-[140px]">{{.ParticipantName}}</span>
            
            <!-- Action buttons: Fullscreen -->
            <div class="absolute top-1.5 right-1.5 flex items-center gap-1 z-10">
                <button
                    type="button"
                    class="btn btn-ghost btn-circle btn-xs text-white/90 hover:text-white hover:bg-black/40"
                    title="Toggle fullscreen"
                    aria-label="Toggle fullscreen"
                    onclick="window.collabClient?.toggleTileFullscreen('{{.TileId}}')"
                >
                    <span class="icon icon-[lucide--maximize-2] size-3.5"></span>
                </button>
            </div>
        </div>
        {{end}}
        {{end}}
    </div>
</div>
