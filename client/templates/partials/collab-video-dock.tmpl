<div id="collab-alerts-container" class="toast toast-top toast-end z-50">
    <div id="collab-alert-mic" class="alert alert-warning text-xs shadow-lg hidden">
        <span class="icon icon-[lucide--alert-triangle] size-4"></span>
        <span>Microphone access denied or unavailable. Joined in listen-only mode.</span>
    </div>
    <div id="collab-alert-cam" class="alert alert-warning text-xs shadow-lg hidden">
        <span class="icon icon-[lucide--alert-triangle] size-4"></span>
        <span>Camera access denied or unavailable.</span>
    </div>
</div>

<div id="collab-video-dock" class="fixed bottom-6 right-6 z-50 flex flex-wrap gap-3 pointer-events-none {{if not (and .CollabSession .CollabSession.VideoEnabled)}}hidden{{end}}">
    <!-- Local User Video Tile -->
    <div id="video-tile-local" class="pointer-events-auto relative rounded-xl overflow-hidden bg-neutral shadow-2xl border border-base-content/15 aspect-video w-48 sm:w-60 transition-transform duration-200 {{if not (and .CollabSession .CollabSession.VideoEnabled)}}hidden{{end}}">
        <video id="collab-local-video" autoplay playsinline muted class="w-full h-full object-cover"></video>
        <span class="absolute bottom-1.5 left-1.5 badge badge-neutral badge-xs text-[10px] font-medium opacity-90 shadow">You</span>
        <button
            type="button"
            class="btn btn-ghost btn-circle btn-xs absolute top-1.5 right-1.5 text-white/90 hover:text-white hover:bg-black/40"
            hx-post="/groups/{{.Group.Id}}/collab/toggle-video"
            hx-target="#collab-header-container"
            hx-swap="outerHTML"
            title="Disable camera"
        >
            <span class="icon icon-[lucide--x] size-3.5"></span>
        </button>
    </div>

    <!-- Remote Participant Video Tile -->
    <div id="video-tile-remote" class="pointer-events-auto relative rounded-xl overflow-hidden bg-neutral shadow-2xl border border-base-content/15 aspect-video w-48 sm:w-60 transition-transform duration-200 hidden">
        <video id="collab-remote-video" autoplay playsinline muted class="w-full h-full object-cover"></video>
        <span class="absolute bottom-1.5 left-1.5 badge badge-neutral badge-xs text-[10px] font-medium opacity-90 shadow">Participant</span>
        <button
            type="button"
            class="btn btn-ghost btn-circle btn-xs absolute top-1.5 right-1.5 text-white/90 hover:text-white hover:bg-black/40"
            onclick="document.getElementById('video-tile-remote')?.classList.add('hidden')"
            title="Hide video"
        >
            <span class="icon icon-[lucide--x] size-3.5"></span>
        </button>
    </div>
</div>
