<header id="header" class="navbar px-2 gap-2">
    <nav class="navbar-start items-center gap-1">
        <a class="btn btn-ghost text-base font-bold gap-2 normal-case text-white hover:text-white shrink-0 px-2" href="/chat" aria-label="{{.AppName}} home">
            <span class="icon icon-logo size-8" aria-hidden="true"></span>
            <span class="hidden sm:inline">{{.AppName}}</span>
        </a>
        <button
            class="btn btn-ghost btn-square btn-sm group-channels-toggle shrink-0"
            type="button"
            aria-label="Toggle channels sidebar"
            title="Toggle channels sidebar"
            aria-controls="channels-view"
            aria-expanded="false"
        >
            <span class="icon icon-[lucide--panel-left] size-5" aria-hidden="true"></span>
        </button>
        {{if and .ActiveChannel (not .ActiveChannel.IsEmpty)}}
        <span
            onclick="document.getElementById('channel-description-modal')?.showModal()"
            class="font-bold text-white flex items-center gap-1 text-sm truncate"
        >
            <span class="icon icon-[lucide--hash] size-4" aria-hidden="true"></span>
            <span class="truncate hidden sm:inline">{{.ActiveChannel.Moniker}}</span>
        </span>
        {{end}}
    </nav>
    <nav class="navbar-end items-center gap-1">
        <button
            class="btn btn-ghost btn-square btn-sm group-members-toggle shrink-0"
            type="button"
            aria-label="Toggle members sidebar"
            title="Toggle members sidebar"
            aria-controls="members-view"
            aria-expanded="false"
        >
            <span class="icon icon-[lucide--panel-right] size-5" aria-hidden="true"></span>
        </button>
        {{- template "partials/avatar-context-menu" .}}
    </nav>
</header>
