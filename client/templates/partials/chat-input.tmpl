<div class="chat-input">
    <form
        class="flex flex-row items-end gap-2 w-full"
        id="send-message-form"
        hx-trigger="submit, keydown[key=='Enter'&&ctrlKey] from:#new-message-input"
        hx-target="#send-message-error"
        hx-headers='{"HX-Error-Wrap": false}'
        hx-swap="innerHTML"
        {{if and .ActiveChannel (not .ActiveChannel.IsEmpty)}}
        hx-post="/groups/{{.Group.Id}}/channels/{{.ActiveChannel.Id}}/messages/create"
        {{else}}
        hx-post="/groups/{{.Group.Id}}/messages/create"
        {{end}}
    >
        <button
            class="btn btn-ghost btn-square shrink-0"
            type="button"
            title="Upload file (disabled)"
            aria-label="Upload file"
            disabled
        >
            <span class="icon icon-[lucide--paperclip] size-5" aria-hidden="true"></span>
        </button>
        <div class="flex flex-col flex-1 min-w-0">
            <div id="send-message-error" class="w-full text-error text-xs font-semibold pb-1 empty:pb-0"></div>
            <textarea
                class="textarea textarea-bordered w-full h-10 min-h-10 max-h-32 field-sizing-content bg-surface-inset text-base leading-snug rounded-lg"
                id="new-message-input"
                form="send-message-form"
                placeholder="Write to {{if and .ActiveChannel (not .ActiveChannel.IsEmpty)}}#{{.ActiveChannel.Moniker}}{{else}}{{.Group.Moniker}}{{end}}"
                name="content"
                rows="1"
                data-autoresize
            ></textarea>
        </div>
        <div>
            <button
                class="btn btn-ghost btn-square"
                title="Send"
                form="send-message-form"
                type="submit"
            >
                <span class="icon icon-[lucide--send] size-5" aria-hidden="true"></span>
            </button>
        </div>
    </form>
</div>
