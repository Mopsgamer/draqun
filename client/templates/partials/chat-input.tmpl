<div class="chat-input">
    <form
        class="flex flex-row items-end gap-2 w-full"
        id="send-message-form"
        hx-trigger="submit, keydown[key=='Enter'&&ctrlKey] from:#new-message-input"
        hx-target="#send-message-error"
        hx-headers='{"HX-Error-Wrap": false}'
        hx-encoding="multipart/form-data"
        hx-swap="innerHTML"
        hx-on::after-request="if(event.detail.successful) { this.reset(); }"
        {{if .IsDirectChat}}
        hx-post="/groups/dm/channels/{{.ActiveChannel.Id}}/messages/create"
        {{else if and .ActiveChannel (not .ActiveChannel.IsEmpty)}}
        hx-post="/groups/{{.Group.Id}}/channels/{{.ActiveChannel.Id}}/messages/create"
        {{else}}
        hx-post="/groups/{{.Group.Id}}/messages/create"
        {{end}}
    >
        <button
            class="btn btn-ghost btn-square shrink-0 cursor-pointer"
            type="button"
            title="Upload files"
            aria-label="Upload files"
            onclick="document.getElementById('file-attachment-input').click()"
        >
            <span class="icon icon-[lucide--paperclip] size-5" aria-hidden="true"></span>
        </button>
        <input
            type="file"
            id="file-attachment-input"
            name="attachments"
            multiple
            class="hidden"
        />
        <div class="flex flex-col flex-1 min-w-0 relative">
            <div id="attachment-preview" class="hidden pb-2 flex-wrap gap-1.5"></div>
            <div id="send-message-error" class="w-full text-error text-xs font-semibold pb-1 empty:pb-0"></div>
            <div id="mention-popover" class="hidden absolute bottom-full mb-2 left-0 right-0 z-30 bg-surface-overlay border border-base-content/15 rounded-xl shadow-xl max-h-48 overflow-y-auto p-1 text-xs"></div>
            <textarea
                class="textarea textarea-bordered w-full h-10 min-h-10 max-h-32 field-sizing-content text-base leading-snug rounded-lg"
                id="new-message-input"
                form="send-message-form"
                placeholder="Write to {{if .IsDirectChat}}@{{.OtherUser.Name}}{{else if and .ActiveChannel (not .ActiveChannel.IsEmpty)}}#{{.ActiveChannel.Moniker}}{{else}}{{.Group.Moniker}}{{end}}"
                name="content"
                rows="1"
                data-autoresize
                {{if .Group}}data-group-id="{{.Group.Id}}"{{else if .IsDirectChat}}data-dm-channel-id="{{.ActiveChannel.Id}}"{{end}}
            ></textarea>
        </div>
        <div>
            <button
                class="btn btn-ghost btn-square cursor-pointer"
                title="Send"
                form="send-message-form"
                type="submit"
            >
                <span class="icon icon-[lucide--send] size-5" aria-hidden="true"></span>
            </button>
        </div>
    </form>
</div>
