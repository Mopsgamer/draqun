<div class="chat-input">
    <form
        class="flex flex-row items-end gap-2 w-full"
        id="send-message-form"
        hx-trigger="submit, keydown[key=='Enter'&&ctrlKey] from:#new-message-input"
        hx-target="#send-message-error"
        hx-headers='{"HX-Error-Wrap": false}'
        hx-swap="innerHTML"
        hx-post="/groups/{{.Group.Id}}/messages/create"
    >
        <div class="flex flex-col flex-1 min-w-0">
            <div id="send-message-error" class="w-full text-error text-xs font-semibold pb-1"></div>
            <textarea
                class="textarea textarea-bordered w-full bg-surface-inset text-base leading-snug rounded-lg"
                id="new-message-input"
                form="send-message-form"
                placeholder="Write to {{.Group.Moniker}}"
                name="content"
                rows="1"
                data-autoresize
            ></textarea>
        </div>
        <div>
            <button
                class="btn btn-ghost btn-square"
                title="Send"
                form="send-message-form"
                type="submit"
            >
                <span class="icon icon-[lucide--send] size-5" aria-hidden="true"></span>
            </button>
        </div>
    </form>
    <div class="flex flex-row items-center w-full text-xs">
        <nav class="breadcrumbs text-xs py-0">
            <ul>
                <li>
                    <a href="/chat" class="flex items-center gap-1">
                        <span class="icon icon-[lucide--house] size-3.5" aria-hidden="true"></span>
                        {{.AppName}}
                    </a>
                </li>
            {{- if not .Group.IsEmpty -}}
                <li>
                    <button
                        class="btn btn-ghost btn-xs gap-1 normal-case group-members-toggle cursor-pointer"
                        type="button"
                        aria-label="Toggle members for {{.Group.Moniker}}"
                        aria-controls="members-view"
                        aria-expanded="false"
                    >
                        <span class="icon icon-[lucide--users] size-3.5" aria-hidden="true"></span>
                        <span>{{- .Group.Moniker -}}</span>
                    </button>
                {{- if .Member.Role.PermGroupChange.Has -}}
                    <span class="inline-flex items-center ml-1">
                        {{template "partials/group-actions" .Group}}
                    </span>
                {{- end -}}
                </li>
            {{- end -}}
            </ul>
        </nav>
    </div>
</div>
