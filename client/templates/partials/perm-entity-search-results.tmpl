{{if .Results}}
    {{$group := .Group}}
    {{$permId := .PermId}}
    {{$entityType := .EntityType}}
    {{range .Results}}
    <div class="flex items-center justify-between p-1.5 hover:bg-base-content/5 rounded text-xs">
        <div class="flex items-center gap-1.5 min-w-0">
            {{if eq $entityType "channel"}}
            <span class="font-bold truncate"># {{.Moniker}}</span>
            <span class="text-[10px] text-base-content/50 font-mono">#{{.Name}}</span>
            {{else if eq $entityType "role"}}
            <span class="font-bold truncate">@ {{.Moniker}}</span>
            <span class="text-[10px] text-base-content/50 font-mono">@{{.Name}}</span>
            {{else}}
            <span class="font-bold truncate">@ {{.Moniker}}</span>
            <span class="text-[10px] text-base-content/50 font-mono">@{{.Name}}</span>
            {{end}}
        </div>
        <button
            type="button"
            class="btn btn-primary btn-xs gap-1 ml-2 shrink-0"
            hx-post="/groups/{{$group.Id}}/permissions/{{$permId}}/attach"
            hx-vals='{"entity_type": "{{$entityType}}", "entity_id": "{{.Id}}"}'
        >
            Attach
        </button>
    </div>
    {{end}}
{{else}}
    <div class="p-2 text-xs text-base-content/50 italic text-center">No matching entities found</div>
{{end}}
