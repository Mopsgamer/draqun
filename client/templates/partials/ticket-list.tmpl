<div class="flex-1 flex flex-col h-full overflow-y-auto p-4 md:p-6 gap-6 bg-surface-canvas">
    <div class="section-header pb-4 flex items-center justify-between gap-3 flex-wrap">
        <div class="flex items-center gap-3 flex-wrap flex-1">
            <!-- Clearable Search Input -->
            <form
                method="GET"
                action="/chat/groups/{{.Group.Id}}/channels/{{.ActiveChannel.Id}}"
                class="relative flex items-center min-w-48 sm:min-w-64 max-w-xs"
            >
                <input type="hidden" name="status" value="{{.StatusFilter}}">
                {{if .OnlyParentsFilter}}<input type="hidden" name="only_parents" value="true">{{end}}
                {{if .AssignedToMeFilter}}<input type="hidden" name="assigned_to_me" value="true">{{end}}
                {{if .CreatedByMeFilter}}<input type="hidden" name="created_by_me" value="true">{{end}}
                <span class="absolute left-2.5 z-10 icon icon-[lucide--search] size-3.5 text-base-content/50 pointer-events-none"></span>
                <input
                    type="text"
                    name="q"
                    value="{{.SearchQuery}}"
                    placeholder="Search tickets..."
                    class="input input-xs input-bordered w-full pl-8 {{if .SearchQuery}}pr-7{{else}}pr-3{{end}} h-8 text-xs rounded-lg bg-surface-card focus:outline-none focus:border-primary"
                />
                {{if .SearchQuery}}
                <a
                    href="/chat/groups/{{.Group.Id}}/channels/{{.ActiveChannel.Id}}?status={{.StatusFilter}}{{if .OnlyParentsFilter}}&only_parents=true{{end}}{{if .AssignedToMeFilter}}&assigned_to_me=true{{end}}{{if .CreatedByMeFilter}}&created_by_me=true{{end}}"
                    class="absolute right-2 z-10 text-base-content/50 hover:text-base-content text-xs p-0.5 font-bold cursor-pointer"
                    title="Clear search"
                >
                    ✕
                </a>
                {{end}}
            </form>

            {{if not .Member.IsEmpty}}
            <button
                class="btn btn-primary btn-sm gap-1.5 shrink-0"
                onclick="document.getElementById('new-ticket-modal').showModal()"
            >
                <span class="icon icon-[lucide--plus] size-4"></span>
                New Ticket
            </button>
            {{end}}

            <!-- Switchers -->
            <div class="flex items-center gap-3.5 flex-wrap ml-auto">
                <label class="inline-flex items-center gap-1.5 cursor-pointer select-none">
                    <input
                        type="checkbox"
                        class="toggle toggle-primary toggle-sm"
                        {{if .OnlyParentsFilter}}checked{{end}}
                        onchange="window.location.href='/chat/groups/{{.Group.Id}}/channels/{{.ActiveChannel.Id}}?status={{.StatusFilter}}{{if .SearchQuery}}&q={{.SearchQuery}}{{end}}{{if .AssignedToMeFilter}}&assigned_to_me=true{{end}}{{if .CreatedByMeFilter}}&created_by_me=true{{end}}' + (this.checked ? '&only_parents=true' : '')"
                    />
                    <span class="text-xs font-medium text-base-content/80">Parents only</span>
                </label>

                <label class="inline-flex items-center gap-1.5 cursor-pointer select-none">
                    <input
                        type="checkbox"
                        class="toggle toggle-primary toggle-sm"
                        {{if .AssignedToMeFilter}}checked{{end}}
                        onchange="window.location.href='/chat/groups/{{.Group.Id}}/channels/{{.ActiveChannel.Id}}?status={{.StatusFilter}}{{if .SearchQuery}}&q={{.SearchQuery}}{{end}}{{if .OnlyParentsFilter}}&only_parents=true{{end}}{{if .CreatedByMeFilter}}&created_by_me=true{{end}}' + (this.checked ? '&assigned_to_me=true' : '')"
                    />
                    <span class="text-xs font-medium text-base-content/80">Assigned to me</span>
                </label>

                <label class="inline-flex items-center gap-1.5 cursor-pointer select-none">
                    <input
                        type="checkbox"
                        class="toggle toggle-primary toggle-sm"
                        {{if .CreatedByMeFilter}}checked{{end}}
                        onchange="window.location.href='/chat/groups/{{.Group.Id}}/channels/{{.ActiveChannel.Id}}?status={{.StatusFilter}}{{if .SearchQuery}}&q={{.SearchQuery}}{{end}}{{if .OnlyParentsFilter}}&only_parents=true{{end}}{{if .AssignedToMeFilter}}&assigned_to_me=true{{end}}' + (this.checked ? '&created_by_me=true' : '')"
                    />
                    <span class="text-xs font-medium text-base-content/80">Created by me</span>
                </label>
            </div>
        </div>
    </div>

    <!-- Tickets Filter Tabs & Box -->
    <div class="flex flex-col gap-2">
        <div class="flex items-center justify-between py-2 text-xs font-medium flex-wrap gap-3">
            <div class="flex items-center gap-4 shrink-0">
                <a
                    href="/chat/groups/{{.Group.Id}}/channels/{{.ActiveChannel.Id}}?status=open{{if .OnlyParentsFilter}}&only_parents=true{{end}}{{if .AssignedToMeFilter}}&assigned_to_me=true{{end}}{{if .CreatedByMeFilter}}&created_by_me=true{{end}}{{if .SearchQuery}}&q={{.SearchQuery}}{{end}}"
                    class="flex items-center gap-1.5 transition-colors {{if eq .StatusFilter "open"}}text-base-content font-bold{{else}}text-base-content/60 hover:text-base-content{{end}}"
                >
                    <span class="icon icon-[lucide--circle-dot] size-4 text-emerald-500"></span>
                    <span>{{.OpenTicketsCount}} Open</span>
                </a>
                <a
                    href="/chat/groups/{{.Group.Id}}/channels/{{.ActiveChannel.Id}}?status=closed{{if .OnlyParentsFilter}}&only_parents=true{{end}}{{if .AssignedToMeFilter}}&assigned_to_me=true{{end}}{{if .CreatedByMeFilter}}&created_by_me=true{{end}}{{if .SearchQuery}}&q={{.SearchQuery}}{{end}}"
                    class="flex items-center gap-1.5 transition-colors {{if eq .StatusFilter "closed"}}text-base-content font-bold{{else}}text-base-content/60 hover:text-base-content{{end}}"
                >
                    <span class="icon icon-[lucide--check-circle-2] size-4 text-purple-500"></span>
                    <span>{{.ClosedTicketsCount}} Closed</span>
                </a>
                <a
                    href="/chat/groups/{{.Group.Id}}/channels/{{.ActiveChannel.Id}}?status=all{{if .OnlyParentsFilter}}&only_parents=true{{end}}{{if .AssignedToMeFilter}}&assigned_to_me=true{{end}}{{if .CreatedByMeFilter}}&created_by_me=true{{end}}{{if .SearchQuery}}&q={{.SearchQuery}}{{end}}"
                    class="transition-colors {{if eq .StatusFilter "all"}}text-base-content font-bold{{else}}text-base-content/60 hover:text-base-content{{end}}"
                >
                    All
                </a>
            </div>
        </div>

        <div class="flex flex-col">
            {{if eq (len .TicketItems) 0}}
            <div class="py-8 text-center flex flex-col items-center justify-center gap-2">
                <span class="icon icon-[lucide--circle-dot] size-8 text-base-content/30"></span>
                <span class="text-sm font-semibold text-base-content/70">No tickets found</span>
                <p class="text-xs text-base-content/50">
                    {{if .SearchQuery}}
                    No tickets matching "{{.SearchQuery}}".
                    {{else}}
                    There are no {{.StatusFilter}} tickets in this channel.
                    {{end}}
                </p>
            </div>
            {{else}}
            {{$groupId := .Group.Id}}
            {{range .TicketItems}}
            <div class="flex items-start justify-between py-3 transition-colors gap-3">
                <div class="flex items-start gap-3 min-w-0 flex-1">
                    <div class="mt-0.5 shrink-0">
                        {{if eq .Channel.Status "closed"}}
                            {{if eq .Channel.ClosedReason "not_planned"}}
                            <span class="icon icon-[lucide--circle-slash] size-4 text-base-content/50" title="Closed as not planned"></span>
                            {{else if eq .Channel.ClosedReason "duplicate"}}
                            <span class="icon icon-[lucide--copy-x] size-4 text-amber-500" title="Closed as duplicate"></span>
                            {{else}}
                            <span class="icon icon-[lucide--check-circle-2] size-4 text-purple-500" title="Closed"></span>
                            {{end}}
                        {{else}}
                        <span class="icon icon-[lucide--circle-dot] size-4 text-emerald-500" title="Open"></span>
                        {{end}}
                    </div>
                    <div class="flex flex-col gap-1 min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <a
                                class="font-bold text-sm text-base-content hover:text-primary transition-colors truncate"
                                href="/chat/groups/{{$groupId}}/channels/{{.Channel.Id}}?status={{$.StatusFilter}}{{if $.OnlyParentsFilter}}&only_parents=true{{end}}{{if $.AssignedToMeFilter}}&assigned_to_me=true{{end}}{{if $.CreatedByMeFilter}}&created_by_me=true{{end}}{{if $.SearchQuery}}&q={{$.SearchQuery}}{{end}}"
                            >
                                {{.Channel.Moniker}}
                            </a>
                            {{if eq .Channel.Status "closed"}}
                                {{if eq .Channel.ClosedReason "not_planned"}}
                                <span class="badge badge-ghost badge-xs">not planned</span>
                                {{else if eq .Channel.ClosedReason "duplicate"}}
                                <span class="badge badge-warning badge-xs">duplicate</span>
                                {{else}}
                                <span class="badge badge-primary badge-xs">completed</span>
                                {{end}}
                            {{end}}
                        </div>
                        <div class="text-xs text-base-content/60 flex items-center gap-2 flex-wrap">
                            <span>#{{.Channel.Id}} opened by <span class="font-medium text-base-content/80">{{if .Author.IsEmpty}}Anonymous{{else}}{{.Author.Moniker}}{{end}}</span></span>
                            {{if gt .Progress.TotalCount 0}}
                            <span>&middot;</span>
                            <span class="inline-flex items-center gap-1 font-mono text-emerald-500 font-medium">
                                <span class="icon icon-[lucide--check-square] size-3"></span>
                                {{.Progress.ClosedCount}}/{{.Progress.TotalCount}} sub-tickets ({{.Progress.Percentage}}%)
                            </span>
                            {{end}}
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-3 shrink-0">
                    {{if .Assignees}}
                    <div class="flex items-center -space-x-1.5 overflow-hidden">
                        {{range .Assignees}}
                        <div class="avatar shrink-0" title="Assigned to {{.Moniker}}">
                            <div class="w-5 h-5 rounded-full ring-1 ring-surface-canvas">
                                <img src="{{.AvatarUrl}}" class="size-full object-cover rounded-full" alt="{{.Moniker}}">
                            </div>
                        </div>
                        {{end}}
                    </div>
                    {{end}}

                    {{if gt .CommentCount 0}}
                    <div class="flex items-center gap-1 text-xs text-base-content/60">
                        <span class="icon icon-[lucide--message-square] size-3.5"></span>
                        <span>{{.CommentCount}}</span>
                    </div>
                    {{end}}
                </div>
            </div>
            {{end}}
            {{end}}
        </div>
    </div>

    <!-- New Ticket Modal -->
    {{if not .Member.IsEmpty}}
    <dialog id="new-ticket-modal" class="modal">
        <div class="modal-box bg-surface-overlay border border-base-content/10 max-w-lg">
            <form method="dialog">
                <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" aria-label="Close modal">✕</button>
            </form>
            <h3 class="font-bold text-lg flex items-center gap-2 pb-2 border-b border-base-content/10">
                <span class="icon icon-[lucide--plus-circle] size-5 text-primary" aria-hidden="true"></span>
                <span>Create New Ticket</span>
            </h3>
            <form
                id="new-ticket-form"
                class="pt-4 flex flex-col gap-4"
                hx-post="/groups/{{.Group.Id}}/channels/{{.ActiveChannel.Id}}/tickets/create"
            >
                <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-semibold text-base-content/70" for="ticket-title">Title</label>
                    <input class="input input-bordered w-full" type="text" id="ticket-title" name="title" placeholder="Ticket title..." required>
                </div>
                <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-semibold text-base-content/70" for="ticket-content">Description / Content</label>
                    <textarea class="textarea textarea-bordered w-full h-32" id="ticket-content" name="content" placeholder="Describe the ticket..."></textarea>
                </div>

                <div class="flex flex-col gap-1.5">
                    <div class="flex items-center justify-between">
                        <label class="text-xs font-semibold text-base-content/70">Parent Ticket Channels</label>
                        <details class="dropdown dropdown-end">
                            <summary class="btn btn-xs btn-primary gap-1 cursor-pointer">
                                <span class="icon icon-[lucide--plus] size-3"></span>
                                <span>Add Parent Ticket</span>
                            </summary>
                            <div class="dropdown-content z-30 p-2.5 shadow-xl bg-surface-overlay rounded-xl border border-base-content/10 w-72 mt-1 flex flex-col gap-2">
                                <span class="font-semibold text-xs text-primary">Search Parent Channel</span>
                                <input
                                    type="text"
                                    name="q"
                                    class="input input-bordered w-full text-xs h-8"
                                    placeholder="Type ID or title to search..."
                                    hx-post="/groups/{{.Group.Id}}/tickets/search"
                                    hx-trigger="input changed delay:200ms, keyup changed delay:200ms"
                                    hx-target="#new-parent-results-list"
                                    hx-vals='{"mode": "parent"}'
                                />
                                <div id="new-parent-results-list" class="max-h-36 overflow-y-auto bg-transparent flex flex-col mt-1">
                                    <div class="p-2 text-xs text-base-content/50 italic text-center">Type above to search tickets</div>
                                </div>
                            </div>
                        </details>
                    </div>
                    <div class="active-parent-badges-container flex flex-wrap gap-1.5 py-1 min-h-8 items-center border border-base-content/10 rounded-lg p-2 bg-surface-canvas">
                        <span class="badge badge-primary badge-sm gap-1 font-mono items-center">
                            <input type="hidden" name="parent_ids" value="{{.ActiveChannel.Id}}" />
                            <span>#{{.ActiveChannel.Id}} {{.ActiveChannel.Moniker}}</span>
                            <span class="text-[10px] opacity-60 cursor-not-allowed" title="Default parent channel">✓</span>
                        </span>
                    </div>
                </div>
            </form>
            <div class="modal-action pt-3">
                <button class="btn btn-sm btn-ghost" type="button" onclick="document.getElementById('new-ticket-modal').close()">Cancel</button>
                <button class="btn btn-sm btn-primary" type="submit" form="new-ticket-form">Submit New Ticket</button>
            </div>
        </div>
        <form method="dialog" class="modal-backdrop">
            <button>close</button>
        </form>
    </dialog>
    {{end}}
</div>

<script>
if (typeof window.getParentItems !== 'function') {
    window.getParentItems = function(container) {
        const items = [];
        if (!container) return items;
        container.querySelectorAll('.badge').forEach(badge => {
            const inp = badge.querySelector('input[name="parent_ids"]');
            const textSpan = badge.querySelector('span:not(.badge)');
            if (inp) {
                let moniker = textSpan ? textSpan.textContent.trim() : '';
                const prefix = '#' + inp.value + ' ';
                if (moniker.startsWith(prefix)) {
                    moniker = moniker.substring(prefix.length);
                }
                items.push({ id: String(inp.value), moniker: moniker });
            }
        });
        return items;
    };

    window.renderParentBadges = function(container, items) {
        if (!container) return;
        const isSingle = items.length <= 1;
        container.innerHTML = items.map(item => `
            <span class="badge badge-primary badge-sm gap-1 font-mono items-center">
                <input type="hidden" name="parent_ids" value="${item.id}" />
                <span>#${item.id} ${item.moniker}</span>
                ${!isSingle ? `
                <button type="button" class="btn btn-ghost btn-xs btn-circle p-0 h-auto min-h-0 text-white/80 hover:text-white cursor-pointer" onclick="removeParentBadge(this, '${item.id}')">✕</button>
                ` : `
                <span class="text-[10px] opacity-60 cursor-not-allowed" title="At least one parent channel is required">✕</span>
                `}
            </span>
        `).join('');
    };

    window.addParentBadge = function(btnEl, newId, newMoniker) {
        const dialog = btnEl.closest('dialog') || document;
        const container = dialog.querySelector('.active-parent-badges-container');
        if (!container) return;
        let items = window.getParentItems(container);
        if (!items.some(it => String(it.id) === String(newId))) {
            items.push({ id: String(newId), moniker: newMoniker });
        }
        window.renderParentBadges(container, items);
    };

    window.removeParentBadge = function(btnEl, removeId) {
        const dialog = btnEl.closest('dialog') || document;
        const container = dialog.querySelector('.active-parent-badges-container');
        if (!container) return;
        let items = window.getParentItems(container);
        if (items.length <= 1) return;
        items = items.filter(it => String(it.id) !== String(removeId));
        window.renderParentBadges(container, items);
    };
}
</script>