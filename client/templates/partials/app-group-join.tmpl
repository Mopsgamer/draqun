<main id="app-content" class="centered-main p-4">
    <div class="flex flex-col items-center text-center p-6 rounded-2xl max-w-md w-full gap-5">
        <div class="avatar shrink-0">
            <div class="w-20 rounded-xl">
                <img src="{{.Group.AvatarUrl}}" alt="Group avatar">
            </div>
        </div>

        <div class="flex flex-col items-center gap-1">
            <h1 class="text-xl font-bold text-base-content">Join {{.Group.Moniker}}</h1>
            <p class="text-xs text-base-content/50 font-mono">@{{.Group.Name}}</p>
        </div>

        {{- with .Group.Description -}}
        <div class="py-2 px-3 rounded-lg text-xs text-base-content/70 w-full">
            {{.}}
        </div>
        {{- end -}}

        {{if .IsBanned}}
        <div class="bg-error/10 text-error border border-error/20 p-4 text-xs w-full rounded-xl flex items-start gap-3 shadow-sm">
            <span class="icon icon-[lucide--ban] size-6 shrink-0 mt-0.5 text-error" aria-hidden="true"></span>
            <div class="flex flex-col min-w-0 text-left gap-1">
                <span class="font-bold text-sm text-error">You are banned from this group</span>
                {{if .BanReason}}
                <span class="text-error/90 font-medium"><span class="font-semibold text-error">Reason:</span> {{.BanReason}}</span>
                {{end}}
                {{if .BanDurationStr}}
                <span class="text-error/80 font-mono text-[11px]"><span class="font-semibold text-error">Duration:</span> {{.BanDurationStr}}</span>
                {{end}}
                <span class="text-error/80 font-mono text-[11px]"><span class="font-semibold text-error">Ban Expiration:</span> {{.BanEndsAtStr}}</span>
            </div>
        </div>
        <div class="flex items-center justify-center w-full pt-2">
            <a class="btn btn-ghost btn-sm w-full" href="/chat">
                Back to Home
            </a>
        </div>
        {{else}}
        <div class="flex items-center justify-center gap-3 w-full pt-2" hx-target="#error-group-join">
            <button
                class="btn btn-primary btn-sm gap-2 flex-1"
                hx-put="/groups/{{.Group.Id}}/join"
            >
                <span class="icon icon-[lucide--user-plus] size-4" aria-hidden="true"></span>
                Join Group
            </button>
            <a class="btn btn-ghost btn-sm flex-1" href="/chat">
                Cancel
            </a>
        </div>
        <div id="error-group-join" class="w-full"></div>
        {{end}}
    </div>
</main>
