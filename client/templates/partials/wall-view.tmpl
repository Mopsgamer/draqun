<div id="wall-container" class="flex-1 flex flex-col h-full bg-surface-canvas overflow-y-auto p-4 md:p-6 gap-4">
    {{if ne .ActiveChannel.Description ""}}
    <div class="flex-1 pt-0 [&_.markdown-body>*:first-child]:mt-0">
        {{markdown .ActiveChannel.Description "message"}}
    </div>
    {{else}}
    <div class="flex-1 flex flex-col items-center justify-center p-8 text-center text-base-content/50 gap-2">
        <span class="icon icon-[lucide--file-text] size-12 opacity-40"></span>
        <p class="text-sm">This wall is empty.</p>
    </div>
    {{end}}

    {{if .WallAttachments}}
    <div class="pt-4 flex flex-col gap-2 shrink-0">
        <h4 class="text-xs font-semibold text-base-content/60 uppercase tracking-wider">Attachments</h4>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
            {{range .WallAttachments}}
            <div class="flex items-center justify-between p-2 rounded-lg border border-base-content/10 bg-base-100 gap-2">
                <a href="{{.FilePath}}" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 min-w-0 flex-1 hover:underline">
                    {{if .IsImage}}
                    <span class="icon icon-[lucide--image] size-4 text-primary shrink-0"></span>
                    {{else}}
                    <span class="icon icon-[lucide--file] size-4 text-primary shrink-0"></span>
                    {{end}}
                    <span class="text-xs font-medium truncate">{{.Filename}}</span>
                    <span class="text-[10px] text-base-content/50 shrink-0">({{.FormattedSize}})</span>
                </a>
                {{if not $.CanWriteDisabled}}
                <button
                    type="button"
                    class="btn btn-ghost btn-square btn-xs text-error"
                    hx-delete="/groups/{{$.Group.Id}}/channels/{{$.ActiveChannel.Id}}/wall/attachments/{{.Id}}"
                    hx-target="#wall-container"
                    hx-swap="outerHTML"
                    title="Delete attachment"
                >
                    <span class="icon icon-[lucide--trash-2] size-3.5"></span>
                </button>
                {{end}}
            </div>
            {{end}}
        </div>
    </div>
    {{end}}

    {{if not .CanWriteDisabled}}
    <div class="pt-4 flex items-center justify-end shrink-0">
        <button
            class="btn btn-primary gap-1"
            hx-get="/groups/{{.Group.Id}}/channels/{{.ActiveChannel.Id}}/wall/edit"
            hx-target="#wall-container"
            hx-swap="outerHTML"
        >
            <span class="icon icon-[lucide--edit-3] size-4"></span>
            Edit
        </button>
    </div>
    {{end}}
</div>
