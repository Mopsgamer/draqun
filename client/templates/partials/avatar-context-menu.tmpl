<details class="dropdown dropdown-end">
    <summary id="avatar-button" class="btn btn-ghost btn-sm normal-case flex items-center gap-2 cursor-pointer list-none">
        <span class="truncate max-w-44 flex items-center gap-1 font-semibold" title={{with .User.Moniker}}{{.}}{{end}}>
            {{if not .User.IsEmpty}}{{.User.Moniker}}{{else}}Guest{{end}}
        </span>
        <span class="inline-flex size-7 items-center justify-center rounded-full bg-white text-[#073b3a]" aria-hidden="true">
            <span class="icon icon-[lucide--user-round] size-4"></span>
        </span>
    </summary>
    <ul class="dropdown-content menu menu-sm w-56 z-30 mt-2 p-1 rounded-box">
        {{- if not .User.IsEmpty -}}
        <li>
            <a href="/settings">
                <span class="icon icon-[lucide--settings] size-4" aria-hidden="true"></span>
                Settings
            </a>
        </li>
        {{- end -}}
        {{- if ne .Ctx.Path "/docs" -}}
        <li>
            <details>
                <summary>
                    <span class="icon icon-[lucide--contrast] size-4" aria-hidden="true"></span>
                    Theme
                </summary>
                <ul>
                    <li>
                        <label>
                            <input type="radio" name="theme-choice" value="dark">
                            <span class="icon icon-[lucide--moon] size-4" aria-hidden="true"></span>
                            Dark
                        </label>
                    </li>
                    <li>
                        <label>
                            <input type="radio" name="theme-choice" value="light">
                            <span class="icon icon-[lucide--sun] size-4" aria-hidden="true"></span>
                            Light
                        </label>
                    </li>
                    <li>
                        <label>
                            <input type="radio" name="theme-choice" value="system">
                            <span class="icon icon-[lucide--monitor] size-4" aria-hidden="true"></span>
                            System
                        </label>
                    </li>
                </ul>
            </details>
        </li>
        {{- end -}}

        {{- if not .User.IsEmpty -}}
        <li>
            <button hx-put="/account/logout" hx-swap="innerHTML">
                <span class="icon icon-[lucide--log-out] size-4" aria-hidden="true"></span>
                Log Out
            </button>
        </li>
        {{- else -}}
        <li>
            <a href="/login">
                <span class="icon icon-[lucide--circle-user-round] size-4" aria-hidden="true"></span>
                Log In
            </a>
        </li>
        {{- end}}
    </ul>
</details>
