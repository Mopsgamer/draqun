<main id="app-content">
    <div class="p-page max-w-6xl">
        <h1 class="text-2xl font-bold mb-4 flex items-center gap-2">Groups</h1>
        <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,14rem),1fr))] gap-4">
            <a href="/groups/create" class="card bg-primary text-primary-content hover:brightness-95 p-4 min-h-36 flex flex-col justify-between transition-all">
                <span class="inline-flex size-10 items-center justify-center rounded-lg bg-white/20" aria-hidden="true">
                    <span class="icon icon-[lucide--plus] size-6"></span>
                </span>
                <div class="flex flex-col gap-0.5">
                    <span class="font-bold text-lg">Create a group</span>
                    <span class="text-sm opacity-80">Start a new group</span>
                </div>
            </a>
            <form
                class="card bg-surface-card p-4 min-h-36 flex flex-col justify-between border border-base-content/10"
                id="join-group-card"
                onsubmit="event.preventDefault(); const val = this.querySelector('input').value.trim(); if(val) { window.location.href = '/chat/groups/join/' + encodeURIComponent(val.replace(/.*\/chat\/groups\/join\//, '')); }"
            >
                <div class="flex flex-col gap-0.5">
                    <span class="inline-flex size-10 items-center justify-center rounded-lg bg-primary/10 text-primary mb-1" aria-hidden="true">
                        <span class="icon icon-[lucide--log-in] size-5"></span>
                    </span>
                    <span class="font-bold text-base">Join a group</span>
                    <span class="text-xs text-base-content/70">Enter name or link</span>
                </div>
                <div class="flex gap-1.5 mt-2">
                    <input
                        type="text"
                        class="input input-bordered input-sm flex-1 min-w-0"
                        placeholder="Group name"
                        aria-label="Group name"
                        required
                    >
                    <button class="btn btn-primary btn-sm shrink-0" type="submit">Join</button>
                </div>
            </form>
            {{- $groupList := .User.GroupList -}}
            {{- $memberList := .User.MemberList -}}
            {{- $this := . -}}
            {{- range $i, $member := $memberList -}}
            {{- $group := index $groupList $i -}}
            {{- $rights := $member.Role -}}
            <div class="relative min-w-0">
                <a
                    id="my-group-{{$group.Id}}"
                    data-id="{{$group.Id}}"
                    href="/chat/groups/{{$group.Id}}"
                    class="card bg-surface-card hover:bg-[var(--surface-card-hover)] p-4 min-h-36 flex flex-col justify-between border border-base-content/10 transition-colors"
                >
                    <div class="avatar shrink-0" aria-hidden="true">
                        <div class="w-10 rounded-xl">
                            <img src="{{$group.AvatarUrl}}" alt="{{$group.Moniker}} avatar">
                        </div>
                    </div>
                    <div class="flex flex-col gap-0.5">
                        <span class="font-bold truncate text-base" title="{{$group.Moniker}}">
                            {{- $group.Moniker -}}
                        </span>
                        {{- if $group.Description -}}
                        <span class="line-clamp-2 text-sm text-base-content/70">{{$group.Description}}</span>
                        {{- end -}}
                    </div>
                </a>
                {{- if not $member.IsEmpty}}
                    <div class="absolute top-2 right-2 z-10">
                        {{template "partials/group-actions" $group}}
                    </div>
                {{- end}}
            </div>
            {{- end -}}
        </div>
    </div>
</main>
