<form
    id="wall-container"
    class="flex-1 flex flex-col h-full bg-surface-canvas overflow-y-auto p-4 md:p-6 gap-4"
    hx-post="/groups/{{.Group.Id}}/channels/{{.ActiveChannel.Id}}/wall"
    hx-target="#wall-container"
    hx-swap="outerHTML"
    hx-encoding="multipart/form-data"
    enctype="multipart/form-data"
>
    <div class="form-group flex-1 flex flex-col min-h-64 pt-0">
        <label class="form-label text-xs font-semibold uppercase tracking-wider text-base-content/70" for="wall-content-input">Markdown Content</label>
        <textarea
            id="wall-content-input"
            name="content"
            class="textarea textarea-bordered w-full flex-1 font-mono text-sm leading-relaxed min-h-64 resize-y p-3"
            placeholder="Type your markdown text here..."
        >{{.ActiveChannel.Description}}</textarea>
    </div>

    <div class="form-group shrink-0 flex flex-col gap-2">
        <div class="flex items-center justify-between">
            <label class="form-label text-xs font-semibold uppercase tracking-wider text-base-content/70" for="wall-attachments-input">Add Attachments</label>
            <button
                type="button"
                class="btn btn-ghost btn-sm gap-1.5 cursor-pointer text-base-content/70 hover:text-base-content"
                onclick="document.getElementById('wall-attachments-input').click()"
            >
                <span class="icon icon-[lucide--paperclip] size-4 text-primary" aria-hidden="true"></span>
                <span class="text-xs">Choose files</span>
            </button>
        </div>
        <input
            id="wall-attachments-input"
            type="file"
            name="attachments"
            multiple
            class="hidden"
        />
        <div id="wall-attachment-preview" class="hidden pb-2 flex-wrap gap-1.5"></div>
    </div>

    {{if .WallAttachments}}
    <div class="pt-2 flex flex-col gap-2 shrink-0">
        <h4 class="text-xs font-semibold text-base-content/60 uppercase tracking-wider">Existing Attachments</h4>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
            {{range .WallAttachments}}
            <div class="flex items-center justify-between p-2 rounded-lg border border-base-content/10 bg-base-100 gap-2">
                <div class="flex items-center gap-2 min-w-0 flex-1">
                    {{if .IsImage}}
                    <span class="icon icon-[lucide--image] size-4 text-primary shrink-0"></span>
                    {{else}}
                    <span class="icon icon-[lucide--file] size-4 text-primary shrink-0"></span>
                    {{end}}
                    <span class="text-xs font-medium truncate">{{.Filename}}</span>
                    <span class="text-[10px] text-base-content/50 shrink-0">({{.FormattedSize}})</span>
                </div>
                <button
                    type="button"
                    class="btn btn-ghost btn-square btn-xs text-error"
                    hx-delete="/groups/{{$.Group.Id}}/channels/{{$.ActiveChannel.Id}}/wall/attachments/{{.Id}}"
                    hx-target="#wall-container"
                    hx-swap="outerHTML"
                    title="Delete attachment"
                >
                    <span class="icon icon-[lucide--trash-2] size-3.5"></span>
                </button>
            </div>
            {{end}}
        </div>
    </div>
    {{end}}

    <div class="pt-4 flex items-center justify-end gap-2 shrink-0">
        <button
            type="button"
            class="btn btn-ghost"
            hx-get="/groups/{{.Group.Id}}/channels/{{.ActiveChannel.Id}}/wall/view"
            hx-target="#wall-container"
            hx-swap="outerHTML"
        >
            Cancel
        </button>
        <button type="submit" class="btn btn-primary gap-1">
            <span class="icon icon-[lucide--check] size-4"></span>
            Save Changes
        </button>
    </div>
</form>
