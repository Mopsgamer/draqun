<!DOCTYPE html>
<html lang="en" data-theme="dark">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{{- .Title -}}</title>
        <link rel="icon" href="/static/assets/logo.svg" type="image/svg+xml">
        {{- template "partials/scripts" . -}}
    </head>

    <body hx-ext="app,debug">
        <div id="real-body">
            {{- template "partials/notice-header" . -}}
            {{- template "partials/header" . -}}
            <main id="main">
                {{- embed -}}
                {{- template "partials/footer" . -}}
            </main>
        </div>

        <!-- Global User Profile Modal Container -->
        <dialog id="user-profile-modal" class="modal">
            <div id="user-profile-modal-content" class="modal-box bg-surface-overlay border border-base-content/10 max-w-lg p-0">
                <!-- Loaded dynamically via HTMX -->
            </div>
            <form method="dialog" class="modal-backdrop">
                <button>close</button>
            </form>
        </dialog>
    </body>
</html>
