{{- $this := . -}}
{{- if eq (len $this.Notifications) 0 -}}
<div class="p-6 text-center text-xs text-base-content/50 italic flex w-full flex-col items-center gap-2">
    <span class="icon icon-[lucide--bell-off] size-5 text-base-content/30" aria-hidden="true"></span>
    <span>No notifications</span>
</div>
{{- else -}}
<div class="divide-y divide-base-content/10 max-h-96 overflow-y-auto w-full">
    {{- range $n := $this.Notifications -}}
    <div class="py-2.5 px-1 text-xs flex flex-col gap-1 w-full">
        {{if eq $n.Type "friend_request"}}
        <div class="flex items-center justify-between gap-2 w-full">
            <div class="flex items-center gap-1.5 min-w-0 flex-1 truncate">
                {{if not $n.IsRead}}
                <span class="size-2 rounded-full bg-error shrink-0" title="Unread"></span>
                {{end}}
                {{if $n.ActorId}}
                <button
                    type="button"
                    onclick="htmx.ajax('GET', '/users/{{$n.ActorId}}/profile', '#user-profile-modal-content'); document.getElementById('user-profile-modal').showModal();"
                    class="font-bold truncate text-base-content hover:underline cursor-pointer text-left"
                    title="View Profile"
                >
                    {{$n.Title}}
                </button>
                {{else}}
                <span class="font-bold truncate text-base-content">{{$n.Title}}</span>
                {{end}}
            </div>
            <div class="flex items-center gap-1 shrink-0">
                <span class="text-[10px] text-base-content/40 truncate shrink-0" datetime="{{jsonTime $n.CreatedAt.Value}}" data-format-date>{{jsonTime $n.CreatedAt.Value}}</span>
            </div>
        </div>
        {{if $n.ActorId}}
        <button
            type="button"
            onclick="htmx.ajax('GET', '/users/{{$n.ActorId}}/profile', '#user-profile-modal-content'); document.getElementById('user-profile-modal').showModal();"
            class="text-base-content/70 text-[11px] leading-tight text-left hover:text-base-content cursor-pointer {{if not $n.IsRead}}pl-3.5{{end}}"
        >
            {{$n.Content}}
        </button>
        {{else}}
        <p class="text-base-content/70 text-[11px] leading-tight {{if not $n.IsRead}}pl-3.5{{end}}">{{$n.Content}}</p>
        {{end}}
        <div class="flex items-center gap-1.5 pt-1 {{if not $n.IsRead}}pl-3.5{{end}}">
            <button
                type="button"
                hx-post="/friends/requests/{{$n.Id}}/accept"
                hx-target="#dropdown-notification-list"
                hx-swap="innerHTML"
                class="btn btn-primary btn-xs flex-1 cursor-pointer"
            >
                <span class="icon icon-[lucide--check] size-3.5"></span>
                Accept
            </button>
            <button
                type="button"
                hx-post="/friends/requests/{{$n.Id}}/decline"
                hx-target="#dropdown-notification-list"
                hx-swap="innerHTML"
                class="btn btn-ghost btn-xs text-error hover:bg-error/10 flex-1 cursor-pointer"
            >
                <span class="icon icon-[lucide--x] size-3.5"></span>
                Decline
            </button>
        </div>
        {{else}}
        <div class="flex items-center justify-between gap-2 w-full">
            <div class="flex items-center gap-1.5 min-w-0 flex-1 truncate">
                {{if not $n.IsRead}}
                <span class="size-2 rounded-full bg-error shrink-0" title="Unread"></span>
                {{end}}
                <a
                    href="{{if eq $n.Type "banned"}}{{if $n.TargetGroup.Name}}/chat/groups/join/{{$n.TargetGroup.Name}}{{else}}/chat{{end}}{{else if ne $n.ChannelId 0}}/chat/groups/{{$n.GroupId}}/channels/{{$n.ChannelId}}{{else if ne $n.GroupId 0}}/chat/groups/{{$n.GroupId}}{{else}}/chat{{end}}"
                    class="font-medium hover:underline truncate min-w-0 text-base-content"
                    title="{{$n.Title}}"
                >
                    {{$n.Title}}
                </a>
            </div>
            <div class="flex items-center gap-1 shrink-0">
                <span class="text-[10px] text-base-content/40 truncate shrink-0" datetime="{{jsonTime $n.CreatedAt.Value}}" data-format-date>{{jsonTime $n.CreatedAt.Value}}</span>
                {{if not $n.IsRead}}
                <button
                    type="button"
                    hx-post="/notifications/{{$n.Id}}/read"
                    hx-target="#dropdown-notification-list"
                    hx-swap="innerHTML"
                    class="btn btn-ghost btn-xs btn-circle p-0 size-5 min-h-0 text-base-content/50 hover:text-base-content"
                    title="Mark as read"
                >
                    <span class="icon icon-[lucide--check] size-3.5"></span>
                </button>
                {{end}}
                <button
                    type="button"
                    hx-delete="/notifications/{{$n.Id}}"
                    hx-target="#dropdown-notification-list"
                    hx-swap="innerHTML"
                    class="btn btn-ghost btn-xs btn-circle p-0 size-5 min-h-0 text-base-content/40 hover:text-error"
                    title="Delete notification"
                >
                    <span class="icon icon-[lucide--trash-2] size-3.5"></span>
                </button>
            </div>
        </div>
        <a
            href="{{if eq $n.Type "banned"}}{{if $n.TargetGroup.Name}}/chat/groups/join/{{$n.TargetGroup.Name}}{{else}}/chat{{end}}{{else if ne $n.ChannelId 0}}/chat/groups/{{$n.GroupId}}/channels/{{$n.ChannelId}}{{else if ne $n.GroupId 0}}/chat/groups/{{$n.GroupId}}{{else}}/chat{{end}}"
            class="text-base-content/60 line-clamp-2 text-[11px] font-normal break-words hover:text-base-content {{if not $n.IsRead}}pl-3.5{{end}}"
        >
            {{$n.Content}}
        </a>
        {{end}}
    </div>
    {{- end -}}
</div>
{{- end -}}
