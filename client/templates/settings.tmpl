<div class="page-container-lg">
    <div class="section-header pb-4">
        <div class="flex-row-start">
            <span class="icon icon-[lucide--settings] size-6 text-primary" aria-hidden="true"></span>
            <div>
                <h1 class="text-2xl font-bold tracking-tight">Account Settings</h1>
                <p class="text-xs text-base-content/60 mt-0.5">Manage your profile details, security preferences, and interface theme.</p>
            </div>
        </div>
        <button class="btn btn-ghost btn-sm text-base-content/70 hover:text-base-content" type="button" onclick="history.back()">
            <span class="icon icon-[lucide--arrow-left] size-4" aria-hidden="true"></span>
            Back
        </button>
    </div>

    <div class="flex flex-col gap-10">
        {{- template "partials/settings-account" . -}}
        {{- template "partials/settings-appearance" . -}}
    </div>
</div>
