<div class="max-w-md mx-auto w-full px-4 py-12 flex flex-col gap-6">
    <div class="flex items-center justify-between pb-3 border-b border-base-content/10">
        <div class="flex items-center gap-2.5">
            <span class="icon icon-[lucide--phone] size-5 text-primary" aria-hidden="true"></span>
            <div>
                <h1 class="text-lg font-bold">Change Phone Number</h1>
                <p class="text-xs text-base-content/60">Update your contact phone number.</p>
            </div>
        </div>
        <button class="btn btn-ghost btn-xs text-base-content/60 hover:text-base-content" type="button" onclick="history.back()">
            <span class="icon icon-[lucide--x] size-4"></span>
        </button>
    </div>

    <form
        class="flex flex-col gap-4"
        id="change-phone-form"
        name="change-phone-form"
        hx-put="/account/change/phone"
        hx-swap="innerHTML"
        hx-target="#change-phone-error"
    >
        <div class="flex flex-col gap-1.5">
            <label class="text-xs font-semibold text-base-content/70" for="change-phone-current-password">Current Password</label>
            <div class="relative w-full">
                <input class="input input-bordered w-full pr-10" autofocus type="password" id="change-phone-current-password" name="current-password" required placeholder="Password">
                <button type="button" class="absolute inset-y-0 right-2 inline-flex items-center justify-center p-1 text-base-content/60 hover:text-base-content cursor-pointer" aria-label="Show password" aria-pressed="false" data-toggle-password>
                    <span class="icon icon-[lucide--eye] size-4" aria-hidden="true" data-password-visible></span>
                    <span class="icon icon-[lucide--eye-off] size-4" aria-hidden="true" data-password-hidden hidden></span>
                </button>
            </div>
        </div>

        <div class="flex flex-col gap-1.5">
            <label class="text-xs font-semibold text-base-content/70" for="new-phone">New Phone Number</label>
            <input class="input input-bordered w-full font-mono text-sm" type="tel" id="new-phone" name="new-phone" inputmode="tel" placeholder="+1 (555) 000-0000">
        </div>

        <div id="change-phone-error"></div>

        <div class="flex justify-end gap-2 pt-2 border-t border-base-content/10">
            <button class="btn btn-ghost btn-sm" type="button" onclick="history.back()">Cancel</button>
            <button class="btn btn-primary btn-sm" form="change-phone-form" type="submit">
                <span class="icon icon-[lucide--check] size-3.5"></span>
                Save
            </button>
        </div>
    </form>
</div>
