<div class="max-w-3xl mx-auto w-full px-4 py-8 flex flex-col gap-8">
    <div class="flex items-center justify-between pb-4 border-b border-base-content/10">
        <div class="flex items-center gap-3">
            <span class="icon icon-[lucide--settings-2] size-6 text-base-content/80" aria-hidden="true"></span>
            <div>
                <h1 class="text-2xl font-bold tracking-tight">Group Settings</h1>
            </div>
        </div>
        <button class="btn btn-ghost btn-sm text-base-content/70 hover:text-base-content" type="button" onclick="history.back()">
            <span class="icon icon-[lucide--arrow-left] size-4" aria-hidden="true"></span>
            Back
        </button>
    </div>

    {{template "partials/group-settings-nav" .}}

    <div class="flex flex-col gap-6">
        <div class="flex items-center justify-between pb-2 border-b border-base-content/10">
            <h2 class="text-base font-bold flex items-center gap-2">
                <span class="icon icon-[lucide--shield-alert] size-4 text-base-content/70" aria-hidden="true"></span>
                Role Hierarchy
            </h2>
            {{if or .Role.PermRoles.Has .Role.PermAdmin.Has (eq .Member.UserId .Group.OwnerId)}}
            <a class="btn btn-primary btn-xs gap-1.5" href="/groups/{{.Group.Id}}/settings/roles/create">
                <span class="icon icon-[lucide--plus] size-3.5" aria-hidden="true"></span>
                Create Role
            </a>
            {{end}}
        </div>

        <div class="divide-y divide-base-content/10">
            {{range $index, $role := .Roles}}
            <div class="py-3.5 flex items-center justify-between gap-4">
                <div class="flex items-center gap-3.5 min-w-0">
                    {{if or $.Role.PermRoles.Has $.Role.PermAdmin.Has (eq $.Member.UserId $.Group.OwnerId)}}
                    <div class="flex flex-col gap-0.5 shrink-0">
                        <button
                            type="button"
                            class="btn btn-ghost btn-square btn-xs size-4.5 min-h-0"
                            hx-post="/groups/{{$.Group.Id}}/roles/{{$role.Id}}/move?direction=up"
                            title="Move Up"
                        >
                            <span class="icon icon-[lucide--chevron-up] size-3"></span>
                        </button>
                        <button
                            type="button"
                            class="btn btn-ghost btn-square btn-xs size-4.5 min-h-0"
                            hx-post="/groups/{{$.Group.Id}}/roles/{{$role.Id}}/move?direction=down"
                            title="Move Down"
                        >
                            <span class="icon icon-[lucide--chevron-down] size-3"></span>
                        </button>
                    </div>
                    {{end}}

                    <span class="size-3.5 rounded-full shrink-0" style="background-color: {{$role.Color.Hex}}"></span>

                    <div class="flex flex-col min-w-0">
                        <div class="font-bold text-sm flex items-center gap-2">
                            <span>{{$role.Moniker}}</span>
                            <span class="text-xs text-base-content/50 font-mono">({{$role.Name}})</span>
                        </div>
                        <div class="text-[11px] text-base-content/50 flex flex-wrap gap-2 mt-0.5 font-mono">
                            <span>Msg: {{$role.PermMessages}}</span>
                            <span>Roles: {{$role.PermRoles}}</span>
                            <span>Members: {{$role.PermMembers}}</span>
                            <span>Admin: {{$role.PermAdmin}}</span>
                        </div>

                        <!-- Assigned members for this role -->
                        {{$roleAssignees := $role.Assignees}}
                        {{if $roleAssignees}}
                        <div class="flex flex-wrap gap-1.5 mt-2">
                            {{range $roleAssignees}}
                            <span class="badge badge-sm gap-1 bg-surface-overlay border border-base-content/10 text-xs">
                                <div class="avatar shrink-0"><div class="w-4 h-4 rounded-full"><img src="{{.AvatarUrl}}" class="size-full object-cover rounded-full" alt="Avatar"></div></div>
                                <span>{{.Moniker}}</span>
                                {{if or $.Role.PermRoles.Has $.Role.PermAdmin.Has (eq $.Member.UserId $.Group.OwnerId)}}
                                <button
                                    type="button"
                                    class="text-base-content/50 hover:text-error ml-0.5 cursor-pointer"
                                    hx-delete="/groups/{{$.Group.Id}}/members/{{.Id}}/roles/{{$role.Id}}"
                                    title="Remove role"
                                >✕</button>
                                {{end}}
                            </span>
                            {{end}}
                        </div>
                        {{end}}
                    </div>
                </div>

                {{if and (ne $role.Name "@everyone") (or $.Role.PermRoles.Has $.Role.PermAdmin.Has (eq $.Member.UserId $.Group.OwnerId))}}
                <div class="flex items-center gap-1 shrink-0">
                    <details class="dropdown dropdown-end">
                        <summary class="btn btn-ghost btn-xs gap-1 cursor-pointer">
                            <span class="icon icon-[lucide--user-plus] size-3"></span> Assign
                        </summary>
                        <div class="dropdown-content z-30 p-3 shadow-xl bg-surface-overlay rounded-lg border border-base-content/10 w-72 mt-1 flex flex-col gap-2">
                            <span class="font-semibold text-xs text-base-content">Assign Member to {{$role.Moniker}}</span>
                            <input
                                type="text"
                                name="q"
                                class="input input-bordered w-full text-xs"
                                placeholder="Search member by name..."
                                hx-post="/groups/{{$.Group.Id}}/members/search"
                                hx-trigger="input changed delay:200ms, keyup changed delay:200ms"
                                hx-target="#role-member-search-{{$role.Id}}"
                                hx-vals='{"role_id": "{{$role.Id}}"}'
                            />
                            <div id="role-member-search-{{$role.Id}}" class="max-h-36 overflow-y-auto border border-base-content/10 rounded-lg p-1 flex flex-col gap-0.5 mt-1">
                                <div class="p-2 text-xs text-base-content/50 italic text-center">Type above to search members</div>
                            </div>
                        </div>
                    </details>
                    <a class="btn btn-ghost btn-xs gap-1 text-base-content/70 hover:text-base-content" href="/groups/{{$.Group.Id}}/settings/roles/{{$role.Id}}">
                        <span class="icon icon-[lucide--pencil] size-3"></span> Edit
                    </a>
                    {{if ne $role.Name "@everyone"}}
                    <details class="dropdown dropdown-end">
                        <summary class="btn btn-ghost btn-xs text-base-content/50 hover:text-error gap-1">
                            <span class="icon icon-[lucide--trash-2] size-3"></span> Delete
                        </summary>
                        <div class="dropdown-content z-20 p-3 shadow-lg bg-surface-overlay rounded-lg border border-base-content/10 w-56 mt-1 flex flex-col gap-2">
                            <span class="font-semibold text-xs text-error">Delete {{$role.Moniker}}?</span>
                            <button
                                type="button"
                                class="btn btn-error btn-xs w-full"
                                hx-delete="/groups/{{$.Group.Id}}/roles/{{$role.Id}}"
                            >Confirm Delete</button>
                        </div>
                    </details>
                    {{end}}
                </div>
                {{end}}
            </div>
            {{else}}
            <div class="text-sm text-base-content/50 text-center py-6">No custom roles created yet.</div>
            {{end}}
        </div>
    </div>
</div>
