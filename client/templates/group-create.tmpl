<div class="p-page max-w-md mx-auto">
    <h1 class="text-2xl font-bold mb-4 flex items-center gap-2">
        <span class="icon icon-[lucide--users]" aria-hidden="true"></span>
        Create new group
    </h1>
    <form
        class="flex flex-col gap-4 bg-surface-card p-6 rounded-box border border-base-content/10 shadow-sm"
        id="new-group-form"
        name="new-group-form"
        hx-post="/groups/create"
        hx-swap="innerHTML"
        hx-target="#new-group-error"
    >
        <div class="flex flex-col gap-1 w-full">
            <label class="text-sm font-semibold" for="new-group-nick">Nick</label>
            <input class="input input-bordered w-full" autofocus type="text" id="new-group-nick" name="nick" required>
        </div>
        <div class="flex flex-col gap-1 w-full">
            <label class="text-sm font-semibold" for="new-group-name">Name</label>
            <input class="input input-bordered w-full" type="text" autocomplete="off" id="new-group-name" name="name" required>
        </div>
        <div class="flex flex-col gap-1 w-full">
            <label class="text-sm font-semibold" for="new-group-password">Password</label>
            <div class="relative w-full">
                <input class="input input-bordered w-full pr-12" type="password" autocomplete="off" id="new-group-password" name="password">
                <button type="button" class="absolute inset-y-0 right-2 inline-flex items-center justify-center p-1 text-base-content/70 hover:text-base-content cursor-pointer" aria-label="Show password" aria-pressed="false" data-toggle-password>
                    <span class="icon icon-[lucide--eye] size-5" aria-hidden="true" data-password-visible></span>
                    <span class="icon icon-[lucide--eye-off] size-5" aria-hidden="true" data-password-hidden hidden></span>
                </button>
            </div>
        </div>
        <div class="flex flex-col gap-1 w-full">
            <label class="text-sm font-semibold" for="new-group-description">Description</label>
            <textarea class="textarea textarea-bordered w-full" id="new-group-description" name="description"></textarea>
        </div>
        <div class="flex flex-col gap-1 w-full">
            <label class="text-sm font-semibold" for="new-group-mode">Mode</label>
            <select class="select select-bordered w-full" id="new-group-mode" name="mode" required>
                <option value="private">Private</option>
                <option value="public" selected>Public</option>
            </select>
        </div>
        <div id="new-group-error"></div>
        <div class="flex justify-end pt-2">
            <button class="btn btn-primary" form="new-group-form" type="submit">Create</button>
        </div>
    </form>
</div>
