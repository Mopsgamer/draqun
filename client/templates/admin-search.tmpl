<div id="real-body">
    {{- template "partials/notice-header" . -}}
    {{- template "partials/app-header" . -}}
    <div id="app-content" class="home">
        <main class="flex-1 overflow-y-auto p-4 md:p-6 min-w-0">
            <div class="max-w-4xl mx-auto flex flex-col gap-6">
                <form
                    hx-get="/chat/admin/search/results"
                    hx-target="#admin-search-results"
                    hx-trigger="submit, input delay:300ms from:#admin-search-input, change from:#admin-type-select"
                    class="flex flex-col md:flex-row items-center gap-3"
                >
                    <div class="relative flex-1 w-full">
                        <span class="absolute inset-y-0 left-0 z-10 flex items-center pl-3 pointer-events-none text-base-content/50">
                            <span class="icon icon-[lucide--search] size-4"></span>
                        </span>
                        <input
                            type="text"
                            id="admin-search-input"
                            name="q"
                            value="{{.Query}}"
                            placeholder="Search by name, moniker, email, phone, or ID..."
                            class="input input-bordered w-full pl-9"
                            autofocus
                        />
                    </div>
                    <div class="flex items-center gap-2 w-full md:w-auto">
                        <select id="admin-type-select" name="type" class="select select-bordered w-full md:w-36">
                            <option value="all" {{if eq .Type "all"}}selected{{end}}>All</option>
                            <option value="groups" {{if eq .Type "groups"}}selected{{end}}>Groups Only</option>
                            <option value="users" {{if eq .Type "users"}}selected{{end}}>Users Only</option>
                        </select>
                        <button type="submit" class="btn btn-primary shrink-0">Search</button>
                    </div>
                </form>

                <div id="admin-search-results" class="flex flex-col gap-6">
                    {{- template "partials/admin-search-results" . -}}
                </div>
            </div>
        </main>
    </div>
</div>
