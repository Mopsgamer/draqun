<div class="p-page max-w-2xl mx-auto flex flex-col gap-6">
    <div class="flex items-center justify-between mb-2">
        <h1 class="text-2xl font-bold flex items-center gap-2">
            <span class="icon icon-[lucide--users]" aria-hidden="true"></span>
            Group settings &middot; {{.Group.Moniker}}
        </h1>
        <button class="btn btn-ghost btn-sm gap-1" type="button" onclick="history.back()">
            <span class="icon icon-[lucide--arrow-left] size-4" aria-hidden="true"></span>
            Back
        </button>
    </div>
    {{template "partials/group-settings-nav" .}}
    <div class="flex flex-col gap-4 bg-surface-card p-6 rounded-box border border-base-content/10 shadow-sm">
        <h2 class="text-xl font-bold pb-2 border-b border-base-content/10 flex items-center gap-2">
            <span class="icon icon-[lucide--history] size-5" aria-hidden="true"></span>
            Audit Log
        </h2>
        <div class="flex flex-col gap-3">
            {{range .AuditItems}}
            <div class="p-3.5 rounded-lg border border-base-content/10 bg-surface-panel flex flex-col gap-2">
                <div class="flex items-center justify-between gap-3">
                    <div class="flex items-center gap-2.5">
                        {{if ne .Target.Moniker ""}}
                        <div class="avatar placeholder">
                            <div class="bg-neutral text-neutral-content rounded-full size-8 flex items-center justify-center">
                                {{if ne .Target.Avatar ""}}
                                <img src="{{.Target.Avatar}}" class="size-full object-cover rounded-full" alt="{{.Target.Moniker}}" />
                                {{else}}
                                <span class="icon icon-[lucide--user] size-5" aria-hidden="true"></span>
                                {{end}}
                            </div>
                        </div>
                        {{else}}
                        <span class="size-8 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0">
                            <span class="icon icon-[lucide--shield] size-4"></span>
                        </span>
                        {{end}}
                        <div class="flex flex-col">
                            <div class="flex items-center gap-2">
                                <span class="badge {{if eq .Kind "Ban"}}badge-error{{else if eq .Kind "Kick"}}badge-warning{{else if eq .Kind "Role Action"}}badge-primary{{else}}badge-neutral{{end}} badge-sm font-semibold">
                                    {{.Kind}}
                                </span>
                                {{if ne .Target.Moniker ""}}
                                <span class="font-bold text-sm">{{.Target.Moniker}}</span>
                                {{end}}
                            </div>
                            {{if ne .Creator.Moniker ""}}
                            <span class="text-xs text-base-content/60">by {{.Creator.Moniker}}</span>
                            {{end}}
                        </div>
                    </div>
                    <span class="text-xs text-base-content/50 font-mono shrink-0">{{.ActedAt}}</span>
                </div>
                {{if ne .Description ""}}
                <div class="text-xs text-base-content/80 pl-10">
                    {{if or (eq .Kind "Membership") (eq .Kind "Role Action")}}{{.Description}}{{else}}<span class="font-semibold text-base-content/60">Reason:</span> {{.Description}}{{end}}
                </div>
                {{end}}
                {{if ne .Details ""}}
                <div class="text-xs text-base-content/60 italic pl-10">{{.Details}}</div>
                {{end}}
            </div>
            {{else}}
            <div class="text-sm text-base-content/60 text-center py-6">No audit log entries recorded yet.</div>
            {{end}}
        </div>
    </div>
</div>
