<div class="p-page">
    <h1>
        <sl-icon name="mailbox2-flag"></sl-icon>
        Change email
    </h1>
    <form
        id="change-email-form"
        name="change-email-form"
        hx-put="/account/change/email"
        hx-swap="innerHTML"
        hx-target="#change-email-error"
    >
        <sl-input
            autofocus
            label="Current password"
            type="password"
            autocomplete="password"
            id="change-email-current-password"
            name="current-password"
            required
            password-toggle
        >
            <sl-icon slot="show-password-icon" name="eye-fill"></sl-icon>
            <sl-icon slot="hide-password-icon" name="eye-slash-fill"></sl-icon>
        </sl-input>

        <sl-input
            label="New email"
            type="text"
            id="new-email"
            autocomplete="off"
            name="new-email"
            inputmode="email"
            required
        >
        </sl-input>
        <div id="change-email-error"></div>
        <div class="form-footer">
            <div>
                <sl-button form="change-email-form" variant="primary" type="submit"
                >Change email</sl-button>
            </div>
        </div>
    </form>
</div>
