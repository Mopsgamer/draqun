<div class="p-page max-w-md mx-auto">
    <h1 class="text-2xl font-bold mb-4 flex items-center gap-2">
        <span class="icon icon-[lucide--lock-keyhole]" aria-hidden="true"></span>
        Change password
    </h1>
    <form
        class="flex flex-col gap-4 bg-surface-card p-6 rounded-box border border-base-content/10 shadow-sm"
        id="change-password-form"
        name="change-password-form"
        hx-put="/account/change/password"
        hx-swap="innerHTML"
        hx-target="#change-password-error"
    >
        <div class="flex flex-col gap-1 w-full">
            <label class="text-sm font-semibold" for="current-password">Current password</label>
            <div class="relative w-full">
                <input class="input input-bordered w-full pr-12" autofocus type="password" id="current-password" name="current-password" required>
                <button type="button" class="absolute inset-y-0 right-2 inline-flex items-center justify-center p-1 text-base-content/70 hover:text-base-content cursor-pointer" aria-label="Show password" aria-pressed="false" data-toggle-password>
                    <span class="icon icon-[lucide--eye] size-5" aria-hidden="true" data-password-visible></span>
                    <span class="icon icon-[lucide--eye-off] size-5" aria-hidden="true" data-password-hidden hidden></span>
                </button>
            </div>
        </div>

        <div class="flex flex-col gap-1 w-full">
            <label class="text-sm font-semibold" for="new-password">New password</label>
            <div class="relative w-full">
                <input class="input input-bordered w-full pr-12" type="password" autocomplete="new-password" id="new-password" name="new-password" required>
                <button type="button" class="absolute inset-y-0 right-2 inline-flex items-center justify-center p-1 text-base-content/70 hover:text-base-content cursor-pointer" aria-label="Show password" aria-pressed="false" data-toggle-password>
                    <span class="icon icon-[lucide--eye] size-5" aria-hidden="true" data-password-visible></span>
                    <span class="icon icon-[lucide--eye-off] size-5" aria-hidden="true" data-password-hidden hidden></span>
                </button>
            </div>
        </div>
        <div class="flex flex-col gap-1 w-full">
            <label class="text-sm font-semibold" for="confirm-new-password">Confirm new password</label>
            <div class="relative w-full">
                <input class="input input-bordered w-full pr-12" type="password" autocomplete="off" id="confirm-new-password" name="confirm-password" required>
                <button type="button" class="absolute inset-y-0 right-2 inline-flex items-center justify-center p-1 text-base-content/70 hover:text-base-content cursor-pointer" aria-label="Show password" aria-pressed="false" data-toggle-password>
                    <span class="icon icon-[lucide--eye] size-5" aria-hidden="true" data-password-visible></span>
                    <span class="icon icon-[lucide--eye-off] size-5" aria-hidden="true" data-password-hidden hidden></span>
                </button>
            </div>
        </div>
        <div id="change-password-error"></div>
        <div class="flex justify-end pt-2">
            <button class="btn btn-primary" form="change-password-form" type="submit">Change password</button>
        </div>
    </form>
</div>
