<div class="page-container-sm">
    <div class="section-header">
        <div class="flex items-center gap-2.5">
            <span class="icon icon-[lucide--key-round] size-5 text-primary" aria-hidden="true"></span>
            <div>
                <h1 class="text-lg font-bold">Change Password</h1>
                <p class="text-xs text-base-content/60">Set a new password for your account.</p>
            </div>
        </div>
        <button class="btn btn-ghost btn-xs text-base-content/60 hover:text-base-content" type="button" onclick="history.back()">
            <span class="icon icon-[lucide--x] size-4"></span>
        </button>
    </div>

    <form
        class="flex flex-col gap-4"
        id="change-password-form"
        name="change-password-form"
        hx-put="/account/change/password"
        hx-swap="innerHTML"
        hx-target="#change-password-error"
    >
        <div class="form-group">
            <label class="form-label" for="current-password">Current Password</label>
            <div class="relative w-full">
                <input class="input input-bordered w-full pr-10" autofocus type="password" id="current-password" name="current-password" required placeholder="Current password">
                <button type="button" class="password-toggle-btn" aria-label="Show password" aria-pressed="false" data-toggle-password>
                    <span class="icon icon-[lucide--eye] size-4" aria-hidden="true" data-password-visible></span>
                    <span class="icon icon-[lucide--eye-off] size-4" aria-hidden="true" data-password-hidden hidden></span>
                </button>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label" for="new-password">New Password</label>
            <div class="relative w-full">
                <input class="input input-bordered w-full pr-10" type="password" autocomplete="new-password" id="new-password" name="new-password" required placeholder="New password">
                <button type="button" class="password-toggle-btn" aria-label="Show password" aria-pressed="false" data-toggle-password>
                    <span class="icon icon-[lucide--eye] size-4" aria-hidden="true" data-password-visible></span>
                    <span class="icon icon-[lucide--eye-off] size-4" aria-hidden="true" data-password-hidden hidden></span>
                </button>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label" for="confirm-new-password">Confirm New Password</label>
            <div class="relative w-full">
                <input class="input input-bordered w-full pr-10" type="password" autocomplete="off" id="confirm-new-password" name="confirm-password" required placeholder="Confirm new password">
                <button type="button" class="password-toggle-btn" aria-label="Show password" aria-pressed="false" data-toggle-password>
                    <span class="icon icon-[lucide--eye] size-4" aria-hidden="true" data-password-visible></span>
                    <span class="icon icon-[lucide--eye-off] size-4" aria-hidden="true" data-password-hidden hidden></span>
                </button>
            </div>
        </div>

        <div id="change-password-error"></div>

        <div class="form-actions">
            <button class="btn btn-ghost btn-sm" type="button" onclick="history.back()">Cancel</button>
            <button class="btn btn-primary btn-sm" form="change-password-form" type="submit">
                <span class="icon icon-[lucide--check] size-3.5"></span>
                Save
            </button>
        </div>
    </form>
</div>
