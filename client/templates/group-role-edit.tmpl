<div class="p-page max-w-xl mx-auto flex flex-col gap-6">
    <h1 class="text-2xl font-bold flex items-center gap-2">
        <span class="icon icon-[lucide--users]" aria-hidden="true"></span>
        Group settings &middot; {{.Group.Moniker}}
    </h1>
    {{template "partials/group-settings-nav" .}}
    <div class="flex flex-col gap-4 bg-surface-card p-6 rounded-box border border-base-content/10 shadow-sm">
        <h2 class="text-xl font-bold pb-2 border-b border-base-content/10 flex items-center gap-2">
            <span class="icon icon-[lucide--shield]" aria-hidden="true"></span>
            Edit Role &middot; {{.TargetRole.Moniker}}
        </h2>
        <form
            class="flex flex-col gap-4"
            id="role-edit-form"
            hx-put="/groups/{{.Group.Id}}/roles/{{.TargetRole.Id}}"
            hx-swap="innerHTML"
            hx-target="#role-edit-error"
        >
            <div class="flex flex-col gap-1 w-full">
                <label class="text-sm font-semibold" for="role-name">Name</label>
                <input class="input input-bordered w-full" type="text" id="role-name" name="name" required value="{{.TargetRole.Name}}" {{if or (eq .TargetRole.Name "@everyone") (not (or .Role.PermRoles.Has .Role.PermAdmin.Has (eq .Member.UserId .Group.OwnerId)))}}readonly disabled{{end}}>
            </div>
            <div class="flex flex-col gap-1 w-full">
                <label class="text-sm font-semibold" for="role-moniker">Moniker (display name)</label>
                <input class="input input-bordered w-full" type="text" id="role-moniker" name="moniker" required value="{{.TargetRole.Moniker}}" {{if not (or .Role.PermRoles.Has .Role.PermAdmin.Has (eq .Member.UserId .Group.OwnerId))}}disabled{{end}}>
            </div>
            <div class="flex flex-col gap-1 w-full">
                <label class="text-sm font-semibold" for="role-color">Role Color</label>
                <input class="input input-bordered h-10 w-24 p-1 cursor-pointer" type="color" id="role-color" name="color" value="{{.TargetRole.Color.Hex}}" {{if not (or .Role.PermRoles.Has .Role.PermAdmin.Has (eq .Member.UserId .Group.OwnerId))}}disabled{{end}}>
            </div>
            <div class="divider my-1">Permissions</div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="flex flex-col gap-1 w-full">
                    <label class="text-sm font-semibold" for="perm-messages">Messages Permission</label>
                    <select class="select select-bordered w-full" id="perm-messages" name="perm_messages" {{if not (or .Role.PermRoles.Has .Role.PermAdmin.Has (eq .Member.UserId .Group.OwnerId))}}disabled{{end}}>
                        <option value="write" {{if eq .TargetRole.PermMessages "write"}}selected{{end}}>Write</option>
                        <option value="read" {{if eq .TargetRole.PermMessages "read"}}selected{{end}}>Read</option>
                        <option value="delete" {{if eq .TargetRole.PermMessages "delete"}}selected{{end}}>Delete (manage all)</option>
                        <option value="hidden" {{if eq .TargetRole.PermMessages "hidden"}}selected{{end}}>Hidden</option>
                    </select>
                </div>
                <div class="flex flex-col gap-1 w-full">
                    <label class="text-sm font-semibold" for="perm-roles">Roles Permission</label>
                    <select class="select select-bordered w-full" id="perm-roles" name="perm_roles" {{if not (or .Role.PermRoles.Has .Role.PermAdmin.Has (eq .Member.UserId .Group.OwnerId))}}disabled{{end}}>
                        <option value="disallow" {{if eq .TargetRole.PermRoles "disallow"}}selected{{end}}>Disallow</option>
                        <option value="allow" {{if eq .TargetRole.PermRoles "allow"}}selected{{end}}>Allow</option>
                    </select>
                </div>
                <div class="flex flex-col gap-1 w-full">
                    <label class="text-sm font-semibold" for="perm-members">Members Permission</label>
                    <select class="select select-bordered w-full" id="perm-members" name="perm_members" {{if not (or .Role.PermRoles.Has .Role.PermAdmin.Has (eq .Member.UserId .Group.OwnerId))}}disabled{{end}}>
                        <option value="read" {{if eq .TargetRole.PermMembers "read"}}selected{{end}}>Read</option>
                        <option value="invite" {{if eq .TargetRole.PermMembers "invite"}}selected{{end}}>Invite</option>
                        <option value="write" {{if eq .TargetRole.PermMembers "write"}}selected{{end}}>Write (manage monikers)</option>
                        <option value="delete" {{if eq .TargetRole.PermMembers "delete"}}selected{{end}}>Delete (kick & ban)</option>
                    </select>
                </div>
                <div class="flex flex-col gap-1 w-full">
                    <label class="text-sm font-semibold" for="perm-group-change">Group Settings Change</label>
                    <select class="select select-bordered w-full" id="perm-group-change" name="perm_group_change" {{if not (or .Role.PermRoles.Has .Role.PermAdmin.Has (eq .Member.UserId .Group.OwnerId))}}disabled{{end}}>
                        <option value="disallow" {{if eq .TargetRole.PermGroupChange "disallow"}}selected{{end}}>Disallow</option>
                        <option value="allow" {{if eq .TargetRole.PermGroupChange "allow"}}selected{{end}}>Allow</option>
                    </select>
                </div>
                <div class="flex flex-col gap-1 w-full col-span-full">
                    <label class="text-sm font-semibold" for="perm-admin">Administrator</label>
                    <select class="select select-bordered w-full" id="perm-admin" name="perm_admin" {{if not (or .Role.PermRoles.Has .Role.PermAdmin.Has (eq .Member.UserId .Group.OwnerId))}}disabled{{end}}>
                        <option value="disallow" {{if eq .TargetRole.PermAdmin "disallow"}}selected{{end}}>Disallow</option>
                        <option value="allow" {{if eq .TargetRole.PermAdmin "allow"}}selected{{end}}>Allow (all permissions)</option>
                    </select>
                </div>
            </div>
            <div id="role-edit-error"></div>
            <div class="flex justify-between items-center pt-2">
                {{if and (ne .TargetRole.Name "@everyone") (or .Role.PermRoles.Has .Role.PermAdmin.Has (eq .Member.UserId .Group.OwnerId))}}
                <button
                    type="button"
                    class="btn btn-error btn-sm"
                    hx-delete="/groups/{{.Group.Id}}/roles/{{.TargetRole.Id}}"
                    hx-confirm="Are you sure you want to delete this role?"
                >Delete Role</button>
                {{else}}
                <div></div>
                {{end}}
                <div class="flex gap-2">
                    <a class="btn btn-ghost" href="/groups/{{.Group.Id}}/settings/roles">Cancel</a>
                    {{if or .Role.PermRoles.Has .Role.PermAdmin.Has (eq .Member.UserId .Group.OwnerId)}}
                    <button class="btn btn-primary" type="submit">Save Changes</button>
                    {{end}}
                </div>
            </div>
        </form>
    </div>
</div>
