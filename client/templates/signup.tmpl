<div class="p-page max-w-md mx-auto">
    <h1 class="text-2xl font-bold mb-4 flex-row-center">
        <span class="icon icon-[lucide--user-round-plus]" aria-hidden="true"></span>
        Sign Up
    </h1>
    <form
        class="form-card"
        id="signup-form"
        name="signup-form"
        hx-post="/account"
        hx-swap="innerHTML"
        hx-target="#signup-error"
    >
        <div class="form-group">
            <label class="form-label" for="signup-moniker">Nick</label>
            <input class="input input-bordered w-full" autofocus type="text" id="signup-moniker" name="moniker" required>
        </div>
        <div class="form-group">
            <label class="form-label" for="signup-name">Name</label>
            <input class="input input-bordered w-full" type="text" id="signup-name" name="name" required>
        </div>
        <div class="form-group">
            <label class="form-label" for="signup-email">Email</label>
            <input class="input input-bordered w-full" type="email" id="signup-email" name="email" inputmode="email" required>
        </div>
        <div class="form-group">
            <label class="form-label" for="signup-password">Password</label>
            <div class="relative w-full">
                <input class="input input-bordered w-full pr-12" type="password" id="signup-password" name="password" required>
                <button type="button" class="password-toggle-btn" aria-label="Show password" aria-pressed="false" data-toggle-password>
                    <span class="icon icon-[lucide--eye] size-5" aria-hidden="true" data-password-visible></span>
                    <span class="icon icon-[lucide--eye-off] size-5" aria-hidden="true" data-password-hidden hidden></span>
                </button>
            </div>
        </div>
        <div class="form-group">
            <label class="form-label" for="signup-confirm-password">Confirm password</label>
            <div class="relative w-full">
                <input class="input input-bordered w-full pr-12" type="password" id="signup-confirm-password" name="confirm-password" required>
                <button type="button" class="password-toggle-btn" aria-label="Show password" aria-pressed="false" data-toggle-password>
                    <span class="icon icon-[lucide--eye] size-5" aria-hidden="true" data-password-visible></span>
                    <span class="icon icon-[lucide--eye-off] size-5" aria-hidden="true" data-password-hidden hidden></span>
                </button>
            </div>
        </div>
        <div id="signup-error"></div>
        <div class="flex items-center justify-between pt-2">
            <div class="text-sm">
                Already a member?
                <a class="btn btn-ghost btn-sm" href="/login">Log In</a>
            </div>
            <div>
                <button class="btn btn-primary" form="signup-form" type="submit">Sign Up</button>
            </div>
        </div>
    </form>
</div>
