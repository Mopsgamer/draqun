<div class="max-w-3xl mx-auto w-full px-4 py-8 flex flex-col gap-8">
    <div class="flex items-center justify-between pb-4 border-b border-base-content/10">
        <div class="flex items-center gap-3">
            <span class="icon icon-[lucide--settings-2] size-6 text-primary" aria-hidden="true"></span>
            <div>
                <h1 class="text-2xl font-bold tracking-tight">Create Channel</h1>
                <p class="text-xs text-base-content/60 mt-0.5">Add a new channel or subchannel for <span class="font-semibold text-base-content/90">{{.Group.Moniker}}</span></p>
            </div>
        </div>
        <button class="btn btn-ghost btn-sm text-base-content/70 hover:text-base-content" type="button" onclick="history.back()">
            <span class="icon icon-[lucide--arrow-left] size-4" aria-hidden="true"></span>
            Back
        </button>
    </div>

    {{template "partials/group-settings-nav" .}}

    <form
        class="flex flex-col gap-6"
        id="create-channel-form"
        hx-post="/groups/{{.Group.Id}}/channels/create"
        hx-swap="innerHTML"
        hx-target="#channel-create-error"
    >
        <div class="pb-2 border-b border-base-content/10 flex items-center justify-between">
            <div>
                <h2 class="text-base font-bold flex items-center gap-2">
                    <span class="icon icon-[lucide--plus-circle] size-4 text-primary" aria-hidden="true"></span>
                    Channel Details
                </h2>
                <p class="text-xs text-base-content/60">Moniker, handle, topic, and parent channel association.</p>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="flex flex-col gap-1.5">
                <label class="text-xs font-semibold text-base-content/70" for="channel-nick">Display Moniker</label>
                <input class="input input-bordered w-full" type="text" id="channel-nick" name="moniker" placeholder="e.g. General Discussion" required>
            </div>
            <div class="flex flex-col gap-1.5">
                <label class="text-xs font-semibold text-base-content/70" for="channel-name">Channel Handle</label>
                <input class="input input-bordered w-full font-mono text-sm" type="text" id="channel-name" name="name" placeholder="e.g. general" required>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="flex flex-col gap-1.5">
                <label class="text-xs font-semibold text-base-content/70" for="channel-description">Description</label>
                <input class="input input-bordered w-full" type="text" id="channel-description" name="description" placeholder="Channel topic or purpose...">
            </div>
            <div class="flex flex-col gap-1.5">
                <label class="text-xs font-semibold text-base-content/70" for="channel-type">Channel Type</label>
                <select class="select select-bordered w-full" id="channel-type" name="type">
                    <option value="text" selected>Text Chat</option>
                    <option value="ticket">Ticket System</option>
                </select>
            </div>
            <div class="flex flex-col gap-1.5">
                <label class="text-xs font-semibold text-base-content/70" for="channel-parent">Parent Channel (Optional Subchannel)</label>
                <select class="select select-bordered w-full" id="channel-parent" name="parent_id">
                    <option value="0">None (Top-level channel)</option>
                    {{range .Channels}}
                    <option value="{{.Id}}"># {{.Moniker}}</option>
                    {{end}}
                </select>
            </div>
        </div>
        <div id="channel-create-error"></div>

        <div class="flex justify-end gap-2 pt-2 border-t border-base-content/10">
            <a class="btn btn-ghost btn-sm" href="/groups/{{.Group.Id}}/settings/channels">Cancel</a>
            <button class="btn btn-primary btn-sm" type="submit">
                <span class="icon icon-[lucide--plus] size-3.5"></span>
                Create Channel
            </button>
        </div>
    </form>
</div>
