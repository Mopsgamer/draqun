<div class="max-w-3xl mx-auto w-full px-4 py-8 flex flex-col gap-8">
    <div class="flex items-center justify-between pb-4 border-b border-base-content/10">
        <div class="flex items-center gap-3">
            <span class="icon icon-[lucide--bell] size-6 text-primary" aria-hidden="true"></span>
            <div>
                <h1 class="text-2xl font-bold tracking-tight">Notifications</h1>
                <p class="text-xs text-base-content/60 mt-0.5">View and manage all your notifications and mention activity.</p>
            </div>
        </div>
        <button class="btn btn-ghost btn-sm text-base-content/70 hover:text-base-content" type="button" onclick="history.back()">
            <span class="icon icon-[lucide--arrow-left] size-4" aria-hidden="true"></span>
            Back
        </button>
    </div>

    <div class="flex flex-col gap-6">
        <div class="flex items-center justify-between pb-2 border-b border-base-content/10">
            <h2 class="text-base font-bold flex items-center gap-2">
                <span class="icon icon-[lucide--bell-ring] size-4 text-primary" aria-hidden="true"></span>
                Activity & Mentions
            </h2>
            <div class="flex items-center gap-2">
                <button
                    type="button"
                    hx-post="/notifications/read-all"
                    hx-target="#page-notification-list"
                    hx-swap="innerHTML"
                    class="btn btn-ghost btn-xs gap-1 text-base-content/70 hover:text-base-content"
                >
                    <span class="icon icon-[lucide--check-check] size-3.5"></span>
                    Mark all read
                </button>
                <button
                    type="button"
                    hx-delete="/notifications/all"
                    hx-target="#page-notification-list"
                    hx-swap="innerHTML"
                    class="btn btn-ghost btn-xs gap-1 text-base-content/50 hover:text-error"
                >
                    <span class="icon icon-[lucide--trash-2] size-3.5"></span>
                    Delete all
                </button>
            </div>
        </div>

        <div id="page-notification-list" class="w-full">
            {{template "partials/notifications" .}}
        </div>
    </div>
</div>
